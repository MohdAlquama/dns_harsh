<div class="max-w mx-auto">
  <div class="mb-7">
    <div class="flex items-center gap-2 text-sm font-medium text-violet-600 mb-2">
      <i data-lucide="settings-2" class="w-4 h-4"></i>
      Authentication settings
    </div>
    <h1 class="text-2xl lg:text-3xl font-bold text-slate-900">OTP Provider</h1>
    <p class="mt-2 text-sm text-slate-500 max-w-2xl">
      View the one-time 2Factor configuration used for admin login, registration, and password-reset OTPs.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <section class="lg:col-span-2 bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">
      <div class="p-5 sm:p-7 border-b border-slate-100 flex items-start justify-between gap-4">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-2xl bg-violet-100 flex items-center justify-center shrink-0">
            <i data-lucide="message-square-lock" class="w-6 h-6 text-violet-700"></i>
          </div>
          <div>
            <h2 class="text-lg font-semibold text-slate-900">2Factor SMS</h2>
            <p class="text-sm text-slate-500 mt-1">Provider credentials are saved on the server and never displayed again.</p>
          </div>
        </div>
        <span id="providerBadge" class="hidden shrink-0 px-3 py-1 rounded-full text-xs font-semibold"></span>
      </div>

      <form id="twoFactorForm" class="p-5 sm:p-7" novalidate>
        <label for="apiKey" class="block text-sm font-semibold text-slate-700 mb-2">2Factor API key</label>
        <div class="relative">
          <i data-lucide="key-round" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
          <input
            id="apiKey"
            name="apiKey"
            type="password"
            autocomplete="new-password"
            required
            placeholder="Paste your 2Factor API key"
            class="w-full h-12 pl-12 pr-12 rounded-2xl border border-slate-300 bg-white text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-100"
          />
          <button
            id="toggleKey"
            type="button"
            aria-label="Show API key"
            class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-violet-700 hover:bg-violet-50 transition"
          >
            <i id="keyVisibilityIcon" data-lucide="eye" class="w-5 h-5"></i>
          </button>
        </div>
        <p class="mt-2 text-xs text-slate-400">Find this key in your 2Factor dashboard under API settings.</p>

        <div id="formMessage" role="status" aria-live="polite" class="hidden mt-5 rounded-2xl px-4 py-3 text-sm"></div>

        <div class="mt-6 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3">
          <p class="text-xs text-slate-400 flex items-center gap-1.5">
            <i data-lucide="lock-keyhole" class="w-3.5 h-3.5"></i>
            The API key is stored server-side only.
          </p>
          <button
            id="saveButton"
            type="submit"
            class="h-11 px-5 rounded-2xl bg-violet-600 text-white text-sm font-semibold flex items-center justify-center gap-2 shadow-md shadow-violet-200 hover:bg-violet-700 disabled:opacity-60 disabled:cursor-not-allowed transition"
          >
            <i data-lucide="save" class="w-4 h-4"></i>
            <span>Save API key</span>
          </button>
        </div>
      </form>
    </section>

    <aside class="space-y-5">
      <div class="bg-slate-900 text-white rounded-3xl p-6 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <div class="w-10 h-10 rounded-2xl bg-white/10 flex items-center justify-center">
            <i data-lucide="activity" class="w-5 h-5 text-violet-300"></i>
          </div>
          <span id="statusDot" class="w-2.5 h-2.5 rounded-full bg-slate-500"></span>
        </div>
        <p class="text-xs uppercase tracking-wider text-slate-400 mt-5">Connection status</p>
        <p id="statusTitle" class="font-semibold mt-1">Checking configuration…</p>
        <p id="statusUpdated" class="text-xs text-slate-400 mt-2">Please wait</p>
      </div>

      <div class="bg-violet-50 border border-violet-100 rounded-3xl p-5">
        <div class="flex gap-3">
          <i data-lucide="info" class="w-5 h-5 text-violet-700 shrink-0 mt-0.5"></i>
          <div>
            <p class="text-sm font-semibold text-violet-900">Used automatically</p>
            <p class="text-xs leading-5 text-violet-700 mt-1">
              Admin login, registration, and forgot-password APIs use this provider automatically.
            </p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  (() => {
    const form = document.getElementById('twoFactorForm');
    const apiKeyInput = document.getElementById('apiKey');
    const toggleKey = document.getElementById('toggleKey');
    const saveButton = document.getElementById('saveButton');
    const message = document.getElementById('formMessage');
    const badge = document.getElementById('providerBadge');
    const statusDot = document.getElementById('statusDot');
    const statusTitle = document.getElementById('statusTitle');
    const statusUpdated = document.getElementById('statusUpdated');

    const showMessage = (text, type) => {
      message.textContent = text;
      message.className = type === 'success'
        ? 'mt-5 rounded-2xl px-4 py-3 text-sm bg-emerald-50 border border-emerald-200 text-emerald-700'
        : 'mt-5 rounded-2xl px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700';
    };

    const updateStatus = (data) => {
      const active = data.configured && data.enabled;
      badge.classList.remove('hidden');
      badge.textContent = active ? 'Configured' : 'Not configured';
      badge.className = active
        ? 'shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700'
        : 'shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700';
      statusDot.className = `w-2.5 h-2.5 rounded-full ${active ? 'bg-emerald-400' : 'bg-amber-400'}`;
      statusTitle.textContent = active ? '2Factor is configured' : 'API key required';
      statusUpdated.textContent = data.updatedAt
        ? `Last updated ${new Date(data.updatedAt).toLocaleString()}`
        : 'Save an API key to enable OTP delivery';
      if (active) {
        apiKeyInput.disabled = true;
        apiKeyInput.placeholder = 'Configured during one-time setup';
        toggleKey.disabled = true;
        saveButton.disabled = true;
        saveButton.querySelector('span').textContent = 'Configuration locked';
      }
    };

    const loadStatus = async () => {
      try {
        const response = await fetch('/api/v1/auth-config/2factor');
        const data = await response.json();
        if (!response.ok) throw new Error(data.message || 'Unable to load configuration');
        updateStatus(data);
      } catch (error) {
        statusTitle.textContent = 'Status unavailable';
        statusUpdated.textContent = error.message;
        statusDot.className = 'w-2.5 h-2.5 rounded-full bg-red-400';
      }
    };

    toggleKey.addEventListener('click', () => {
      const showing = apiKeyInput.type === 'text';
      apiKeyInput.type = showing ? 'password' : 'text';
      toggleKey.setAttribute('aria-label', showing ? 'Show API key' : 'Hide API key');
      document.getElementById('keyVisibilityIcon').setAttribute('data-lucide', showing ? 'eye' : 'eye-off');
      lucide.createIcons();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const apiKey = apiKeyInput.value.trim();
      if (!apiKey) {
        showMessage('Please enter your 2Factor API key.', 'error');
        apiKeyInput.focus();
        return;
      }

      saveButton.disabled = true;
      saveButton.querySelector('span').textContent = 'Saving…';
      message.classList.add('hidden');

      try {
        const response = await fetch('/api/v1/auth-config/2factor', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ apiKey })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.message || 'Unable to save API key');

        apiKeyInput.value = '';
        apiKeyInput.type = 'password';
        showMessage(data.message, 'success');
        await loadStatus();
      } catch (error) {
        showMessage(error.message, 'error');
      } finally {
        if (!apiKeyInput.disabled) {
          saveButton.disabled = false;
          saveButton.querySelector('span').textContent = 'Save API key';
        }
      }
    });

    loadStatus();
  })();
</script>
