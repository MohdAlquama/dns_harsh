<div class="max-w-7xl mx-auto space-y-6">

    <!-- Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

        <div>
            <p class="text-sm font-semibold text-violet-600">
                App Management
            </p>

            <h1 class="text-2xl font-bold text-slate-900">
                App Versions
            </h1>

            <p class="mt-1 text-sm text-slate-500">
                Manage app versions, update requirements and release settings.
            </p>
        </div>

        <a
            href="/app-versions/new"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-violet-700"
        >
            <i data-lucide="plus" class="h-4 w-4"></i>
            New App Version
        </a>

    </div>


    <!-- Alerts -->

    <% if (saved) { %>
        <div class="flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            <i data-lucide="circle-check" class="h-5 w-5"></i>
            App version created successfully.
        </div>
    <% } %>

    <% if (updated) { %>
        <div class="flex items-center gap-3 rounded-2xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-700">
            <i data-lucide="circle-check" class="h-5 w-5"></i>
            App version updated successfully.
        </div>
    <% } %>

    <% if (deleted) { %>
        <div class="flex items-center gap-3 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <i data-lucide="trash-2" class="h-5 w-5"></i>
            App version deleted successfully.
        </div>
    <% } %>

    <% if (toggled) { %>
        <div class="flex items-center gap-3 rounded-2xl border border-violet-200 bg-violet-50 px-4 py-3 text-sm text-violet-700">
            <i data-lucide="refresh-cw" class="h-5 w-5"></i>
            App version status updated successfully.
        </div>
    <% } %>

    <% if (error) { %>
        <div class="flex items-center gap-3 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <i data-lucide="circle-alert" class="h-5 w-5"></i>
            <%= error %>
        </div>
    <% } %>


    <!-- Table -->

    <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

        <% if (!versions || versions.length === 0) { %>

            <div class="flex flex-col items-center justify-center px-6 py-20 text-center">

                <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-violet-50 text-violet-600">
                    <i data-lucide="smartphone" class="h-8 w-8"></i>
                </div>

                <h2 class="text-lg font-semibold text-slate-900">
                    No app versions found
                </h2>

                <p class="mt-2 max-w-md text-sm text-slate-500">
                    Create your first app version to start managing updates.
                </p>

                <a
                    href="/app-versions/new"
                    class="mt-6 inline-flex items-center gap-2 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-violet-700"
                >
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    Create Version
                </a>

            </div>

        <% } else { %>

            <div class="overflow-x-auto">

                <table class="min-w-full text-sm">

                    <thead class="bg-slate-50">

                        <tr class="border-b border-slate-200">

                            <th class="px-6 py-4 text-left font-semibold text-slate-600">
                                Version
                            </th>

                            <th class="px-6 py-4 text-left font-semibold text-slate-600">
                                Platform
                            </th>

                            <th class="px-6 py-4 text-left font-semibold text-slate-600">
                                Minimum
                            </th>

                            <th class="px-6 py-4 text-left font-semibold text-slate-600">
                                Screen
                            </th>

                            <th class="px-6 py-4 text-left font-semibold text-slate-600">
                                Schedule
                            </th>

                            <th class="px-6 py-4 text-left font-semibold text-slate-600">
                                Status
                            </th>

                            <th class="px-6 py-4 text-right font-semibold text-slate-600">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody class="divide-y divide-slate-100">

                        <% versions.forEach((version) => { %>

                            <tr class="transition hover:bg-slate-50">

                                <!-- Version -->

                                <td class="whitespace-nowrap px-6 py-5">

                                    <div class="flex items-center gap-3">

                                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                                            <i data-lucide="smartphone" class="h-5 w-5"></i>
                                        </div>

                                        <div>
                                            <div class="font-semibold text-slate-900">
                                                <%= version.version_name %>
                                            </div>

                                            <div class="text-xs text-slate-500">
                                                Code: <%= version.version_code %>
                                            </div>
                                        </div>

                                    </div>

                                </td>


                                <!-- Platform -->

                                <td class="px-6 py-5">

                                    <% if (version.platform === "ANDROID") { %>

                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                                            <i data-lucide="smartphone" class="h-3.5 w-3.5"></i>
                                            Android
                                        </span>

                                    <% } else if (version.platform === "IOS") { %>

                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                                            <i data-lucide="apple" class="h-3.5 w-3.5"></i>
                                            iOS
                                        </span>

                                    <% } else { %>

                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-violet-50 px-3 py-1 text-xs font-semibold text-violet-700">
                                            <i data-lucide="smartphones" class="h-3.5 w-3.5"></i>
                                            Both
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Minimum Version -->

                                <td class="whitespace-nowrap px-6 py-5">

                                    <span class="font-semibold text-slate-800">
                                        <%= version.minimum_version_code %>
                                    </span>

                                    <% if (Number(version.minimum_version_code) >= Number(version.version_code)) { %>

                                        <span class="ml-1 text-xs text-red-500">
                                            Force
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Screen -->

                                <td class="px-6 py-5">

                                    <span class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
                                        <%= version.screen %>
                                    </span>

                                </td>


                                <!-- Schedule -->

                                <td class="whitespace-nowrap px-6 py-5">

                                    <% if (version.schedule_date) { %>

                                        <div class="flex items-center gap-2 text-slate-600">
                                            <i data-lucide="calendar-clock" class="h-4 w-4"></i>

                                            <%= new Date(version.schedule_date).toLocaleString("en-IN", {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric",
                                                hour: "2-digit",
                                                minute: "2-digit"
                                            }) %>
                                        </div>

                                    <% } else { %>

                                        <span class="text-slate-400">
                                            Immediate
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Status -->

                                <td class="px-6 py-5">

                                    <% if (version.is_active) { %>

                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                            Active
                                        </span>

                                    <% } else { %>

                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500">
                                            <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                            Inactive
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Actions -->

                                <td class="px-6 py-5">

                                    <div class="flex items-center justify-end gap-2">

                                        <!-- Toggle -->

                                        <form
                                            method="POST"
                                            action="/app-versions/<%= version.id %>/toggle"
                                        >

                                            <button
                                                type="submit"
                                                title="<%= version.is_active ? 'Deactivate' : 'Activate' %>"
                                                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition hover:border-violet-200 hover:bg-violet-50 hover:text-violet-600"
                                            >

                                                <i
                                                    data-lucide="<%= version.is_active ? 'power-off' : 'power' %>"
                                                    class="h-4 w-4"
                                                ></i>

                                            </button>

                                        </form>


                                        <!-- Edit -->

                                        <a
                                            href="/app-versions/<%= version.id %>/edit"
                                            title="Edit"
                                            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-600"
                                        >
                                            <i data-lucide="pencil" class="h-4 w-4"></i>
                                        </a>


                                        <!-- Delete -->

                                        <form
                                            method="POST"
                                            action="/app-versions/<%= version.id %>/delete"
                                            onsubmit="return confirm('Are you sure you want to delete this app version?');"
                                        >

                                            <button
                                                type="submit"
                                                title="Delete"
                                                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600"
                                            >
                                                <i data-lucide="trash-2" class="h-4 w-4"></i>
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>

        <% } %>

    </div>

</div>

<script>
    if (window.lucide) {
        lucide.createIcons();
    }
</script>