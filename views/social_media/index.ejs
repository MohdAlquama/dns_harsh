<div class="w-full">
  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-indigo-950 to-violet-900 text-white p-6 sm:p-8 mb-6 shadow-xl shadow-violet-100">
    <div class="absolute -right-20 -top-24 w-72 h-72 rounded-full bg-violet-500/20 blur-3xl"></div>
    <div class="absolute right-40 -bottom-32 w-64 h-64 rounded-full bg-blue-400/10 blur-3xl"></div>
    <div class="relative flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/10 px-3 py-1.5 text-xs font-semibold text-violet-100 mb-4">
          <i data-lucide="share-2" class="w-3.5 h-3.5"></i>
          Website configuration
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">Social Media Accounts</h1>
        <p class="mt-3 text-sm sm:text-base text-slate-300 max-w-2xl">Control how your official social profiles appear across the website and mobile applications.</p>
      </div>
      <div class="grid grid-cols-2 gap-3 w-full lg:w-auto">
        <div class="min-w-32 rounded-2xl bg-white/10 border border-white/10 px-4 py-3 backdrop-blur">
          <p class="text-xs text-slate-300">Active accounts</p>
          <p id="activeCount" class="text-2xl font-bold mt-1">—</p>
        </div>
        <div class="min-w-32 rounded-2xl bg-white/10 border border-white/10 px-4 py-3 backdrop-blur">
          <p class="text-xs text-slate-300">Configured</p>
          <p id="configuredCount" class="text-2xl font-bold mt-1">—</p>
        </div>
      </div>
    </div>
  </section>

  <div class="mb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h2 class="text-lg font-bold text-slate-900">Connected platforms</h2>
      <p class="text-sm text-slate-500 mt-1">Add the account name and full profile URL, then switch its status to active.</p>
    </div>
    <div id="summaryBadge" class="self-start sm:self-auto px-3 py-1.5 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold">Loading…</div>
  </div>

  <form id="socialMediaForm" novalidate>
    <div id="accountGrid" class="grid grid-cols-1 xl:grid-cols-2 gap-5"></div>

    <div id="formMessage" role="status" aria-live="polite" class="hidden mt-5 rounded-2xl px-4 py-3 text-sm"></div>

    <div class="sticky bottom-0 mt-6 py-4 bg-slate-50/95 backdrop-blur border-t border-slate-200 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-xs text-slate-500 flex items-center gap-1.5">
        <i data-lucide="info" class="w-4 h-4"></i>
        Only active accounts are returned by the public API.
      </p>
      <button id="saveButton" type="submit" class="h-11 px-6 rounded-2xl bg-violet-600 text-white text-sm font-semibold flex items-center justify-center gap-2 shadow-md shadow-violet-200 hover:bg-violet-700 disabled:opacity-60 disabled:cursor-not-allowed transition">
        <i data-lucide="save" class="w-4 h-4"></i>
        <span>Save changes</span>
      </button>
    </div>
  </form>
</div>

<script>
  (() => {
    const platforms = [
      { key: 'YOUTUBE', name: 'YouTube', logo: 'https://cdn.simpleicons.org/youtube/FF0000', fallback: 'youtube', accent: 'border-t-red-500', logoBg: 'bg-red-50', placeholder: 'https://www.youtube.com/@yourchannel' },
      { key: 'INSTAGRAM', name: 'Instagram', logo: 'https://cdn.simpleicons.org/instagram/E4405F', fallback: 'instagram', accent: 'border-t-pink-500', logoBg: 'bg-pink-50', placeholder: 'https://www.instagram.com/youraccount' },
      { key: 'FACEBOOK', name: 'Facebook', logo: 'https://cdn.simpleicons.org/facebook/0866FF', fallback: 'facebook', accent: 'border-t-blue-500', logoBg: 'bg-blue-50', placeholder: 'https://www.facebook.com/yourpage' },
      { key: 'X', name: 'X (Twitter)', logo: 'https://cdn.simpleicons.org/x/000000', fallback: 'at-sign', accent: 'border-t-slate-900', logoBg: 'bg-slate-100', placeholder: 'https://x.com/youraccount' }
    ];
    const grid = document.getElementById('accountGrid');
    const form = document.getElementById('socialMediaForm');
    const message = document.getElementById('formMessage');
    const saveButton = document.getElementById('saveButton');
    const summaryBadge = document.getElementById('summaryBadge');
    const activeCount = document.getElementById('activeCount');
    const configuredCount = document.getElementById('configuredCount');

    const escapeHtml = (value = '') => String(value).replace(/[&<>'"]/g, (character) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
    })[character]);

    const render = (accounts) => {
      const accountMap = new Map(accounts.map((account) => [account.platform, account]));
      grid.innerHTML = platforms.map((platform) => {
        const account = accountMap.get(platform.key) || {};
        return `
          <section class="bg-white border border-slate-200 border-t-4 ${platform.accent} rounded-3xl shadow-sm p-5 sm:p-6 hover:shadow-md transition-shadow" data-platform="${platform.key}">
            <div class="flex items-center justify-between gap-4 mb-5">
              <div class="flex items-center gap-3">
                <div class="w-14 h-14 rounded-2xl ${platform.logoBg} border border-slate-100 flex items-center justify-center shrink-0">
                  <img src="${platform.logo}" alt="${platform.name} logo" width="28" height="28" loading="lazy" referrerpolicy="no-referrer" class="w-7 h-7 object-contain" onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden')">
                  <i data-lucide="${platform.fallback}" class="hidden w-6 h-6 text-slate-500"></i>
                </div>
                <div><h2 class="text-base font-bold text-slate-900">${platform.name}</h2><p class="text-xs text-slate-400 mt-0.5">Official profile settings</p></div>
              </div>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <span class="status-label text-xs font-semibold ${account.isActive ? 'text-emerald-600' : 'text-slate-400'}">${account.isActive ? 'Active' : 'Inactive'}</span>
                <input type="checkbox" class="status-input sr-only peer" ${account.isActive ? 'checked' : ''}>
                <span class="relative w-11 h-6 bg-slate-200 rounded-full peer peer-checked:bg-emerald-500 transition after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:bg-white after:rounded-full after:shadow after:transition peer-checked:after:translate-x-5"></span>
              </label>
            </div>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Account label / name</label>
                <input type="text" maxlength="100" class="label-input w-full h-11 px-4 rounded-xl border border-slate-300 bg-slate-50/50 text-sm outline-none focus:bg-white focus:border-violet-500 focus:ring-4 focus:ring-violet-100" placeholder="e.g. DNS Education" value="${escapeHtml(account.label)}">
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Profile link</label>
                <div class="relative">
                  <i data-lucide="link-2" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                  <input type="url" maxlength="500" class="url-input w-full h-11 pl-10 pr-4 rounded-xl border border-slate-300 bg-slate-50/50 text-sm outline-none focus:bg-white focus:border-violet-500 focus:ring-4 focus:ring-violet-100" placeholder="${platform.placeholder}" value="${escapeHtml(account.profileUrl)}">
                </div>
              </div>
              <div class="flex items-center justify-between pt-1 text-xs text-slate-400">
                <span class="flex items-center gap-1.5"><i data-lucide="globe-2" class="w-3.5 h-3.5"></i> Visible on public API when active</span>
                <span class="completion-label font-semibold"></span>
              </div>
            </div>
          </section>`;
      }).join('');
      bindStatusLabels();
      bindConfigurationInputs();
      updateSummary();
      lucide.createIcons();
    };

    const bindStatusLabels = () => document.querySelectorAll('.status-input').forEach((input) => {
      input.addEventListener('change', () => {
        const label = input.closest('label').querySelector('.status-label');
        label.textContent = input.checked ? 'Active' : 'Inactive';
        label.className = `status-label text-xs font-semibold ${input.checked ? 'text-emerald-600' : 'text-slate-400'}`;
        updateSummary();
      });
    });

    const bindConfigurationInputs = () => document.querySelectorAll('[data-platform]').forEach((card) => {
      card.querySelectorAll('.label-input, .url-input').forEach((input) => input.addEventListener('input', updateSummary));
    });

    const updateSummary = () => {
      const active = document.querySelectorAll('.status-input:checked').length;
      let configured = 0;
      document.querySelectorAll('[data-platform]').forEach((card) => {
        const complete = Boolean(card.querySelector('.label-input').value.trim() && card.querySelector('.url-input').value.trim());
        if (complete) configured += 1;
        const completionLabel = card.querySelector('.completion-label');
        completionLabel.textContent = complete ? 'Complete' : 'Details required';
        completionLabel.className = `completion-label font-semibold ${complete ? 'text-emerald-600' : 'text-amber-600'}`;
      });
      summaryBadge.textContent = `${active} of ${platforms.length} active`;
      summaryBadge.className = `self-start sm:self-auto px-3 py-1.5 rounded-full text-xs font-semibold ${active ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600'}`;
      activeCount.textContent = `${active}/${platforms.length}`;
      configuredCount.textContent = `${configured}/${platforms.length}`;
    };

    const showMessage = (text, type) => {
      message.textContent = text;
      message.className = type === 'success'
        ? 'mt-5 rounded-2xl px-4 py-3 text-sm bg-emerald-50 border border-emerald-200 text-emerald-700'
        : 'mt-5 rounded-2xl px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700';
    };

    const loadAccounts = async () => {
      try {
        const response = await fetch('/api/v1/admin/social-media');
        const data = await response.json();
        if (!response.ok) throw new Error(data.message || 'Unable to load settings');
        render(data.accounts);
      } catch (error) {
        grid.innerHTML = `<div class="xl:col-span-2 p-6 rounded-3xl bg-red-50 border border-red-200 text-red-700 text-sm">${escapeHtml(error.message)}</div>`;
        summaryBadge.textContent = 'Unavailable';
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const accounts = [...grid.querySelectorAll('[data-platform]')].map((card) => ({
        platform: card.dataset.platform,
        label: card.querySelector('.label-input').value.trim(),
        profileUrl: card.querySelector('.url-input').value.trim(),
        isActive: card.querySelector('.status-input').checked
      }));

      for (const account of accounts) {
        if (account.isActive && (!account.label || !account.profileUrl)) {
          showMessage(`${account.platform}: add both an account label and profile link before enabling it.`, 'error');
          return;
        }
      }

      saveButton.disabled = true;
      saveButton.querySelector('span').textContent = 'Saving…';
      try {
        const response = await fetch('/api/v1/admin/social-media', {
          method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ accounts })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.message || 'Unable to save settings');
        showMessage(data.message, 'success');
        await loadAccounts();
      } catch (error) {
        showMessage(error.message, 'error');
      } finally {
        saveButton.disabled = false;
        saveButton.querySelector('span').textContent = 'Save changes';
      }
    });

    loadAccounts();
  })();
</script>
