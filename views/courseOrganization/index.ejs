<div class="mx-auto p-4">

  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-200 pb-5">
    <div>
      <p class="text-sm font-medium text-violet-600 mb-2 flex items-center gap-2">
        Course Organization <span class="text-gray-400">|</span>
        <a class="underline hover:text-violet-800" href="/organization/awsConfig">AWS Config</a>
        <span class="text-gray-400">/</span>
        <a class="underline hover:text-violet-800" href="/organization/aws/videos">S3 Videos</a>
      </p>
      <h1 class="text-2xl font-bold text-slate-900 mt-1">Course Folders</h1>
      <p class="text-sm text-slate-500 mt-1">Browse your courses as a directory tree.</p>
    </div>
    <div class="flex items-center gap-3">
      <button type="button" onclick="expandAll()" class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 px-4 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50 transition">
        Expand All
      </button>
      <button type="button" onclick="collapseAll()" class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 px-4 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50 transition">
        Collapse All
      </button>
      <button type="button" onclick="openFolderModal()" class="inline-flex items-center justify-center gap-2 bg-violet-600 text-white font-semibold px-5 py-2.5 rounded-xl hover:bg-violet-700 transition shadow-md shadow-violet-200 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        New Folder
      </button>
    </div>
  </div>

  <!-- Tree View -->
  <div class="rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden mt-6">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
      <h3 class="font-bold text-gray-900 font-mono text-sm">~/course-organization</h3>
      <span class="text-xs font-semibold bg-violet-100 text-violet-700 px-3 py-1 rounded-full">
        <%= typeof folders !== 'undefined' ? folders.length : 0 %> Folders
      </span>
    </div>

    <div class="p-6 overflow-x-auto">
      <div id="treeRoot" class="tree font-mono text-sm"></div>
      <div id="emptyState" class="hidden text-center text-gray-500 py-10">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-violet-50 text-violet-600 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
        </div>
        <p class="font-medium text-gray-800">No folders created yet.</p>
        <p class="text-xs text-gray-400 mt-1">Click "New Folder" to get started.</p>
      </div>
    </div>
  </div>
</div>

<!-- Create Folder Modal -->
<div id="createFolderModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-60 backdrop-blur-sm p-4 transition-opacity">
  <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4">
      <h3 class="text-lg font-bold text-gray-900">Create New Folder</h3>
      <button type="button" onclick="closeFolderModal()" class="rounded-full p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-900 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <form id="createFolderForm" class="p-6 space-y-5">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Folder Name</label>
        <input type="text" name="folderName" required class="w-full rounded-xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Assign Course Name</label>
        <input type="text" name="courseName" required class="w-full rounded-xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20">
      </div>
      <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-gray-100">
        <button type="button" onclick="closeFolderModal()" class="rounded-xl px-5 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-100 transition">Cancel</button>
        <button type="submit" class="rounded-xl bg-violet-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-violet-700 shadow-sm">Create Folder</button>
      </div>
    </form>
  </div>
</div>

<style>
  .tree ul { list-style: none; margin: 0; padding-left: 1.5rem; }
  .tree > ul { padding-left: 0; }
  .tree li { position: relative; padding-left: 1.25rem; }
  .tree li::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    border-left: 1px solid #d1d5db;
    height: 100%;
  }
  .tree li:last-child::before { height: 1.15rem; }
  .tree li::after {
    content: "";
    position: absolute;
    top: 1.15rem;
    left: 0;
    width: 0.85rem;
    border-top: 1px solid #d1d5db;
  }
  .tree > ul > li::before,
  .tree > ul > li::after { display: none; }
  .node-row { display: flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0.4rem; border-radius: 0.5rem; cursor: pointer; }
  .node-row:hover { background: #f8fafc; }
  .toggle-icon { transition: transform 0.15s ease; flex-shrink: 0; }
  .toggle-icon.open { transform: rotate(90deg); }
  .children.collapsed { display: none; }
</style>

<script>
  const folderTree = <%- JSON.stringify(typeof folderTree !== 'undefined' ? folderTree : []) %>;
</script>
<script src="/js/courseFolder.js"></script>