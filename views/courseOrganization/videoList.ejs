<div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm mt-8  mx-auto relative">
    
    <!-- Notifications -->
    <div id="successToast" class="hidden absolute top-4 right-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg shadow-md flex items-center gap-3 z-50 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="toastMessage" class="font-medium">Action successful!</span>
    </div>

    <!-- Header & Action Buttons -->
    <div class="mb-6 border-b border-gray-200 pb-4 flex justify-between items-center">
        <div>
            <h2 class="text-xl font-semibold text-gray-900">S3 Uploaded Videos</h2>
            <p class="mt-1 text-sm text-gray-500">All video files currently in your bucket.</p>
        </div>
        <div class="flex items-center gap-4">
            <div class="text-sm text-gray-500">
                Total Videos: <span id="totalVideosCount" class="font-bold text-indigo-600"><%= videos ? videos.length : 0 %></span>
            </div>
            
            <!-- Upload Button -->
            <input type="file" id="videoUploadInput" accept="video/mp4,video/x-m4v,video/*" class="hidden">
            <button type="button" onclick="document.getElementById('videoUploadInput').click()" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
                Upload Video
            </button>
        </div>
    </div>

    <% if (error) { %>
        <div class="mb-4 rounded-lg bg-red-50 p-4 text-red-800 border border-red-200">
             <%= error %>
        </div>
    <% } %>

    <!-- Table Section -->
   <!-- Table Section -->
    <div class="overflow-x-auto rounded-lg border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
            <thead class="bg-gray-50 text-gray-700">
                <tr>
                    <th class="px-6 py-3 font-medium">Video File Details</th>
                    <th class="px-6 py-3 font-medium">Size & Type</th>
                    <th class="px-6 py-3 font-medium">Upload Timeline</th>
                    <th class="px-6 py-3 font-medium">Actions</th>
                </tr>
            </thead>
            <tbody id="videoTableBody" class="divide-y divide-gray-200 bg-white">
                <% if (videos && videos.length > 0) { %>
                    <% videos.forEach(function(video, index) { %>
                        <tr class="hover:bg-gray-50 video-row" style="display: none;">
                            
                            <!-- 1. File Details (Name, Format, Hash) -->
                            <td class="px-6 py-4">
                                <div class="font-medium text-gray-900 truncate max-w-xs" title="<%= video.fileName %>">
                                    <%= video.fileName %>
                                </div>
                                <div class="mt-1 flex items-center gap-2 text-xs text-gray-500">
                                    <span class="rounded bg-gray-100 px-1.5 py-0.5 font-semibold text-gray-600"><%= video.fileFormat %></span>
                                    <span class="truncate max-w-[150px]" title="ETag: <%= video.fileHash %>">Hash: <%= video.fileHash %></span>
                                </div>
                            </td>

                            <!-- 2. Size & Storage Class -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="font-medium text-gray-900"><%= video.size %></div>
                                <div class="mt-1 text-xs text-gray-500">Class: <%= video.storageClass %></div>
                            </td>
                            
                            <!-- 3. Upload Timeline (Date, Time, Relative) -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900 font-medium">
                                    <%= video.uploadDate %> <span class="text-gray-400">at</span> <%= video.uploadTime %>
                                </div>
                                <div class="mt-1 text-xs font-semibold text-indigo-600">
                                    <%= video.relativeTime %>
                                </div>
                            </td>
                            
                            <!-- 4. Actions -->
                            <td class="px-6 py-4 flex items-center gap-2">
                                <button type="button" onclick="openVideoModal('<%= video.url %>', '<%= video.fileName %>')" class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-50 px-3 py-2 text-xs font-medium text-indigo-700 transition hover:bg-indigo-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg> Play
                                </button>
                                <button type="button" onclick="copyVideoLink('<%= video.url %>', this)" class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs font-medium text-gray-700 transition hover:bg-gray-50">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg> Copy Link
                                </button>
                                <button type="button" onclick="deleteVideo('<%= video.fileName %>')" class="inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-medium text-red-700 transition hover:bg-red-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    <% }); %>
                <% } else if (!error) { %>
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-gray-500">No videos found in your S3 bucket.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    <% if (videos && videos.length > 0) { %>
        <div class="mt-6 flex items-center justify-between border-t border-gray-200 pt-4">
            <button id="prevPageBtn" onclick="prevPage()" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
            <span class="text-sm text-gray-600">Page <span id="currentPageDisplay" class="font-bold">1</span> of <span id="totalPagesDisplay" class="font-bold">1</span></span>
            <button id="nextPageBtn" onclick="nextPage()" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
        </div>
    <% } %>
</div>

<!-- Upload Progress Modal & Video Player Modal (Same as before) -->
<div id="uploadModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-60 backdrop-blur-sm p-4">
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Uploading Video to S3</h3>
        <p id="uploadingFileName" class="text-sm text-gray-500 mb-4 truncate">Preparing upload...</p>
        <div class="w-full bg-gray-200 rounded-full h-2.5 mb-2 overflow-hidden">
            <div id="uploadProgressBar" class="bg-indigo-600 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
        <div class="flex justify-between text-xs font-medium text-gray-600">
            <span id="uploadProgressText">0%</span>
            <span class="text-indigo-600 animate-pulse">Uploading in background...</span>
        </div>
    </div>
</div>

<div id="videoModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-80 backdrop-blur-sm p-4">
    <div class="relative w-full max-w-4xl rounded-2xl bg-white shadow-2xl overflow-hidden">
        <div class="flex items-center justify-between bg-gray-900 px-6 py-4 text-white">
            <h3 id="modalVideoTitle" class="text-lg font-semibold truncate pr-4">Video Preview</h3>
            <button onclick="closeVideoModal()" class="rounded-full p-2 text-gray-300 hover:bg-gray-700 hover:text-white transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="aspect-video w-full bg-black">
            <video id="awsVideoPlayer" controls controlsList="nodownload" class="h-full w-full outline-none">
                <source id="videoSource" src="" type="video/mp4">
            </video>
        </div>
    </div>
</div>

<script>
    const successToast = document.getElementById('successToast');
    const toastMessage = document.getElementById('toastMessage');

    function showToast(msg) {
        toastMessage.innerText = msg;
        successToast.classList.remove('hidden');
        setTimeout(() => successToast.classList.add('hidden'), 3000);
    }

    // --- Delete Logic (NEW) ---
    async function deleteVideo(fileName) {
        if (!confirm(`Are you sure you want to delete "${fileName}"? This action cannot be undone.`)) {
            return;
        }

        try {
            const res = await fetch('/organization/aws/videos', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fileName })
            });
            const data = await res.json();

            if (data.success) {
                showToast("Video deleted successfully!");
                setTimeout(() => window.location.reload(), 1500); // Reload to update table
            } else {
                alert("Delete Failed: " + data.error);
            }
        } catch (error) {
            console.error(error);
            alert("An error occurred while deleting the video.");
        }
    }

    // --- Upload Logic (Same as before) ---
    const videoUploadInput = document.getElementById('videoUploadInput');
    const uploadModal = document.getElementById('uploadModal');
    const uploadProgressBar = document.getElementById('uploadProgressBar');
    const uploadProgressText = document.getElementById('uploadProgressText');
    const uploadingFileName = document.getElementById('uploadingFileName');

    videoUploadInput.addEventListener('change', async function() {
        const file = this.files[0];
        if (!file) return;

        videoUploadInput.value = ''; 
        uploadProgressBar.style.width = '0%';
        uploadProgressText.innerText = '0%';
        uploadingFileName.innerText = file.name;
        uploadModal.classList.remove('hidden');
        uploadModal.classList.add('flex');

        try {
            const res = await fetch(`/organization/aws/videos/upload-url?fileName=${encodeURIComponent(file.name)}&fileType=${encodeURIComponent(file.type)}`);
            const data = await res.json();
            
            if (!data.success) throw new Error(data.error);

            const xhr = new XMLHttpRequest();
            xhr.open('PUT', data.uploadUrl, true);
            xhr.setRequestHeader('Content-Type', file.type);

            xhr.upload.onprogress = function(e) {
                if (e.lengthComputable) {
                    const percentComplete = Math.round((e.loaded / e.total) * 100);
                    uploadProgressBar.style.width = percentComplete + '%';
                    uploadProgressText.innerText = percentComplete + '%';
                }
            };

            xhr.onload = function() {
                if (xhr.status === 200) {
                    uploadModal.classList.remove('flex');
                    uploadModal.classList.add('hidden');
                    showToast("Video uploaded successfully!");
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    throw new Error('S3 Upload failed. Check bucket CORS settings.');
                }
            };
            xhr.onerror = function() { throw new Error('Network error during upload.'); };
            xhr.send(file); 
        } catch (error) {
            alert("Upload Error: " + error.message);
            uploadModal.classList.remove('flex');
            uploadModal.classList.add('hidden');
        }
    });

    // --- Copy Link Logic ---
    function copyVideoLink(url, btnElement) {
        navigator.clipboard.writeText(url).then(() => {
            const originalHTML = btnElement.innerHTML;
            btnElement.innerHTML = ` Copied`;
            btnElement.classList.add('text-green-700', 'border-green-400', 'bg-green-50');
            setTimeout(() => {
                btnElement.innerHTML = originalHTML;
                btnElement.classList.remove('text-green-700', 'border-green-400', 'bg-green-50');
            }, 2000);
        }).catch(err => alert('Failed to copy link.'));
    }

    // --- Pagination Logic ---
    const rowsPerPage = 5;
    let currentPage = 1;
    const rows = document.querySelectorAll('.video-row');
    const totalPages = Math.ceil(rows.length / rowsPerPage);

    function displayRows() {
        if (rows.length === 0) return;
        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;
        rows.forEach((row, index) => {
            row.style.display = (index >= start && index < end) ? '' : 'none'; 
        });
        document.getElementById('currentPageDisplay').innerText = currentPage;
        document.getElementById('totalPagesDisplay').innerText = totalPages;
        document.getElementById('prevPageBtn').disabled = (currentPage === 1);
        document.getElementById('nextPageBtn').disabled = (currentPage === totalPages || totalPages === 0);
    }
    function nextPage() { if (currentPage < totalPages) { currentPage++; displayRows(); } }
    function prevPage() { if (currentPage > 1) { currentPage--; displayRows(); } }

    // --- Video Modal Logic ---
    const videoModal = document.getElementById('videoModal');
    const awsVideoPlayer = document.getElementById('awsVideoPlayer');
    const videoSource = document.getElementById('videoSource');
    const modalVideoTitle = document.getElementById('modalVideoTitle');

    function openVideoModal(url, fileName) {
        videoSource.src = url;
        modalVideoTitle.innerText = fileName;
        awsVideoPlayer.load();
        videoModal.classList.remove('hidden');
        videoModal.classList.add('flex');
        awsVideoPlayer.play().catch(e => console.log("Auto-play prevented"));
    }

    function closeVideoModal() {
        awsVideoPlayer.pause();
        videoSource.src = ""; 
        videoModal.classList.add('hidden');
        videoModal.classList.remove('flex');
    }

    document.addEventListener('DOMContentLoaded', () => { displayRows(); });
</script>