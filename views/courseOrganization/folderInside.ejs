<div class="max-w-6xl mx-auto space-y-6 mt-8 p-4">
  
  <!-- Breadcrumb & Header Section -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-200 pb-5">
    <div>
      <p class="text-sm font-medium text-violet-600 mb-2 flex items-center gap-2">
        <a class="underline hover:text-violet-800" href="/organization">All Folders</a> 
        <span class="text-gray-400">/</span> 
        <span class="text-gray-700 font-semibold"><%= folder.folder_name %></span>
      </p>
      <h1 class="text-2xl font-bold text-slate-900 mt-1 flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
        <%= folder.folder_name %>
      </h1>
      <p class="text-sm text-slate-500 mt-1">Course: <span class="font-medium text-slate-700"><%= folder.course_name %></span></p>
    </div>
    
    <button type="button" onclick="openAssignVideoModal()" 
            class="inline-flex items-center justify-center gap-2 bg-violet-600 text-white font-semibold px-5 py-2.5 rounded-xl hover:bg-violet-700 transition shadow-md shadow-violet-200 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Assign Video from S3
    </button>
  </div>

  <!-- Videos Table Section -->
  <div class="rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden mt-6">
      <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
          <h3 class="font-bold text-gray-900">Assigned Course Videos</h3>
          <span class="text-xs font-semibold bg-violet-100 text-violet-700 px-3 py-1 rounded-full">
              <%= typeof videos !== 'undefined' ? videos.length : 0 %> Videos
          </span>
      </div>

      <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
              <thead class="bg-gray-50 text-gray-700">
                  <tr>
                      <th class="px-6 py-3 font-medium">Video File Details</th>
                      <th class="px-6 py-3 font-medium">File Size</th>
                      <th class="px-6 py-3 font-medium">Assigned Date</th>
                      <th class="px-6 py-3 font-medium text-right">Actions</th>
                  </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                  <% if (typeof videos !== 'undefined' && videos.length > 0) { %>
                      <% videos.forEach(function(video) { %>
                          <tr class="hover:bg-gray-50 transition">
                              <td class="px-6 py-4">
                                  <div class="font-medium text-gray-900 truncate max-w-sm"><%= video.fileName %></div>
                                  <div class="text-xs text-gray-400 mt-0.5">S3 Object Key</div>
                              </td>
                              <td class="px-6 py-4 text-gray-500 whitespace-nowrap">
                                  <span class="rounded bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600"><%= video.size || 'N/A' %></span>
                              </td>
                              <td class="px-6 py-4 text-gray-500 whitespace-nowrap text-xs">
                                  <%= video.assignedAt || 'Just now' %>
                              </td>
                              <td class="px-6 py-4 text-right space-x-2 whitespace-nowrap">
                                  <button type="button" onclick="playAssignedVideo('<%= video.url %>')" class="inline-flex items-center gap-1 rounded-lg bg-violet-50 px-3 py-1.5 text-xs font-medium text-violet-700 hover:bg-violet-100 transition">
                                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> Play
                                  </button>
                                  <button type="button" onclick="removeVideoFromFolder(<%= folder.id %>, '<%= video.id %>')" class="inline-flex items-center gap-1 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-100 transition">
                                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg> Remove
                                  </button>
                              </td>
                          </tr>
                      <% }); %>
                  <% } else { %>
                      <tr>
                          <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-violet-50 text-violet-600 mb-3">
                                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                              </div>
                              <p class="font-medium text-gray-800">No videos in this folder yet.</p>
                              <p class="text-xs text-gray-400 mt-1">Click "Assign Video from S3" to attach your course videos.</p>
                          </td>
                      </tr>
                  <% } %>
              </tbody>
          </table>
      </div>
  </div>

</div>