<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin login | DNS</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="min-h-screen bg-slate-950 flex items-center justify-center p-4">
  <main class="w-full max-w-md rounded-3xl bg-white p-7 sm:p-9 shadow-2xl">
    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-600 to-indigo-600 text-white flex items-center justify-center text-2xl font-bold">D</div>
    <p class="text-sm font-semibold text-violet-600 mt-6">Protected administration</p>
    <h1 class="text-3xl font-bold text-slate-900 mt-1">Admin login</h1>
    <p class="text-sm text-slate-500 mt-2">Enter your phone number and password. An OTP is required next.</p>
    <% if (error) { %><div class="mt-5 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700"><%= error %></div><% } %>
    <form method="POST" action="/admin/login" class="mt-6 space-y-4">
      <label class="block text-sm font-semibold text-slate-700">Phone number<input name="phoneNumber" inputmode="numeric" autocomplete="username" required class="mt-2 w-full rounded-xl border border-slate-300 p-3 outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-100" placeholder="10-digit mobile number"></label>
      <label class="block text-sm font-semibold text-slate-700">Password<input type="password" name="password" autocomplete="current-password" required class="mt-2 w-full rounded-xl border border-slate-300 p-3 outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-100" placeholder="Your password"></label>
      <button class="w-full rounded-xl bg-violet-600 py-3 text-white font-semibold hover:bg-violet-700">Continue to OTP</button>
    </form>
  </main>
</body></html>
