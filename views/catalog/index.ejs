<div class="max-w-7xl mx-auto space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div><p class="text-sm font-semibold text-violet-600">Catalog management</p><h1 class="mt-1 text-2xl font-bold text-slate-900"><%= config.plural %></h1><p class="mt-1 text-sm text-slate-500">Create, publish, and maintain <%= config.plural.toLowerCase() %> exposed by the public API.</p></div>
    <a href="<%= config.basePath %>/new" class="inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-5 py-3 font-semibold text-white shadow-md shadow-violet-200 hover:bg-violet-700"><i data-lucide="plus-circle" class="h-4 w-4"></i> New <%= config.label %></a>
  </div>
  <% if (saved || updated || deleted) { %><div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-700"><%= deleted ? `${config.label} deleted.` : `${config.label} saved successfully.` %></div><% } %>
  <% if (error) { %><div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"><%= error %></div><% } %>

  <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <% if (!products.length) { %><div class="py-16 text-center"><i data-lucide="<%= config.icon %>" class="mx-auto h-10 w-10 text-slate-300"></i><h2 class="mt-3 font-semibold text-slate-700">No <%= config.plural.toLowerCase() %> yet</h2><p class="mt-1 text-sm text-slate-500">Create the first <%= config.label.toLowerCase() %> to publish it through the API.</p></div><% } else { %>
    <div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-slate-50 text-left text-slate-500"><tr><th class="p-4">Product</th><th class="p-4"><%= type === 'TEST_SERIES' ? 'Test configuration' : 'Book details' %></th><th class="p-4">Price</th><th class="p-4">Status</th><th class="p-4 text-right">Actions</th></tr></thead>
      <tbody class="divide-y divide-slate-100"><% products.forEach((product) => { %><tr class="hover:bg-slate-50/60">
        <td class="p-4"><p class="font-semibold text-slate-800"><%= product.title %></p><p class="mt-1 font-mono text-xs text-slate-400"><%= product.slug %> · #<%= product.id %></p></td>
        <td class="p-4 text-slate-600"><% if (type === 'TEST_SERIES') { %><p><%= product.test_mode %> · <%= product.total_questions %> questions</p><p class="mt-1 text-xs text-slate-400"><%= product.duration_minutes %> min · <%= product.attempt_limit %> attempt(s)</p><% } else { %><p><%= product.author %></p><p class="mt-1 text-xs text-slate-400"><%= product.book_format %> · <%= product.language %><%= product.isbn ? ` · ${product.isbn}` : '' %></p><% } %></td>
        <td class="p-4 font-semibold">₹<%= Number(product.base_price).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
        <td class="p-4"><span class="rounded-full px-2.5 py-1 text-xs font-bold <%= product.status === 'PUBLISHED' ? 'bg-emerald-100 text-emerald-700' : product.status === 'COMING_SOON' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600' %>"><%= product.status.replaceAll('_', ' ') %></span></td>
        <td class="p-4"><div class="flex justify-end gap-2"><a href="<%= config.basePath %>/<%= product.id %>/edit" class="rounded-lg border border-violet-200 px-3 py-2 text-xs font-semibold text-violet-700 hover:bg-violet-50">Edit</a><form method="POST" action="<%= config.basePath %>/<%= product.id %>/delete" onsubmit="return confirm('Delete this <%= config.label.toLowerCase() %>?');"><button class="rounded-lg border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50">Delete</button></form></div></td>
      </tr><% }) %></tbody>
    </table></div><% } %>
  </section>
</div>
