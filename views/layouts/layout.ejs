<!-- views/layouts/layout.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'DNS Admin' %></title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Tailwind CSS -->
  <link rel="stylesheet" href="/css/output.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } }
    };
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<!-- Body mein h-screen add karein -->
<body class="bg-slate-50 font-sans antialiased text-slate-800 flex overflow-hidden h-screen">

  <!-- Sidebar -->
  <%- include('./sidebar') %>

  <!-- Yahan min-h-screen ko hatakar h-screen kar dein -->
  <div id="mainContent" class="flex flex-col flex-1 w-full h-screen transition-all duration-300 lg:ml-[260px]">
    
    <!-- Header -->
    <%- include('./header') %>

    <!-- Page Content (Ab yahan perfectly scroll hoga) -->
    <main class="flex-1 p-4 lg:p-8 animate-fadeIn overflow-x-hidden overflow-y-auto relative">
      <%- include(page) %>
    </main>

  </div>
  <!-- Init Lucide Icons -->
  <script>
    lucide.createIcons();
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.4s ease-out;
    }
  </style>
<!-- Add this before </body> in layout.ejs -->
<script>
  // 1. Disable right-click context menu
  document.addEventListener('contextmenu', function(e) {
    e.preventDefault();
  });

  // 2. Block common DevTools shortcuts
  document.addEventListener('keydown', function(e) {
    // F12
    if (e.key === 'F12') { e.preventDefault(); return false; }
    // Ctrl+Shift+I / J / C (Inspect, Console, Element picker)
    if (e.ctrlKey && e.shiftKey && ['I','J','C','i','j','c'].includes(e.key)) {
      e.preventDefault(); return false;
    }
    // Ctrl+U (View Source)
    if (e.ctrlKey && (e.key === 'u' || e.key === 'U')) {
      e.preventDefault(); return false;
    }
    // Ctrl+S (Save Page)
    if (e.ctrlKey && (e.key === 's' || e.key === 'S')) {
      e.preventDefault(); return false;
    }
  });

  // 3. Detect if DevTools is already open (approximate, not foolproof)
  (function () {
    const threshold = 160;
    setInterval(function () {
      const widthDiff = window.outerWidth - window.innerWidth;
      const heightDiff = window.outerHeight - window.innerHeight;
      if (widthDiff > threshold || heightDiff > threshold) {
        document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;font-size:18px;color:#333;">DevTools access is disabled on this page.</div>';
      }
    }, 1000);
  })();

  // 4. Disable text selection (optional — remove if it breaks forms/inputs)
  document.addEventListener('selectstart', function(e) {
    if (!['INPUT','TEXTAREA'].includes(e.target.tagName)) e.preventDefault();
  });
</script>

<style>
  /* Disable drag on images/videos (basic deterrent) */
  img, video {
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: auto;
  }
</style>
</body>
</html>
