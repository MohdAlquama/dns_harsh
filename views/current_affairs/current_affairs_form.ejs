
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Current Affairs Course Settings</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        textarea::-webkit-scrollbar {
            width: 8px;
        }

        textarea::-webkit-scrollbar-thumb {
            background-color: #d8b4fe;
            border-radius: 4px;
        }

        textarea::-webkit-scrollbar-track {
            background-color: #f3f4f6;
        }

        .grid-visible {
            display: grid !important;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-800 font-sans min-h-screen p-4 md:p-8">

<div class="max-w-7xl mx-auto space-y-6">

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-purple-800">
            <%= typeof courseId !== 'undefined' && courseId ? 'Edit' : 'New' %> Current Affairs Course
        </h1>

        <p class="text-gray-500 text-sm mt-1">
            Manage course details, pricing, offers, and uploads.
        </p>
    </div>


    <% if (typeof error !== 'undefined' && error) { %>
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= error %>
        </div>
    <% } %>

    <form action="<%= typeof courseId !== 'undefined' && courseId ? `/current-affairs/${courseId}/edit` : '/current-affairs' %>" method="POST" enctype="multipart/form-data" class="space-y-6">

        <!-- ===================================================== -->
        <!-- 1. BASIC DETAILS -->
        <!-- ===================================================== -->

        <section class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">

            <h2 class="text-lg font-semibold text-purple-800 mb-4 border-b border-gray-100 pb-2">
                1. Basic Details
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Course Name
                    </label>

                    <input
                        type="text"
                        name="course_name"
                        required
                        class="w-full rounded border border-gray-300 p-2 text-sm focus:border-purple-500 focus:outline-none"
                    >
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Short Description
                    </label>

                    <textarea
                        name="short_description"
                        rows="2"
                        class="w-full rounded border border-gray-300 p-2 text-sm focus:border-purple-500 focus:outline-none resize-y"
                    ></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Publishing status</label>
                    <select name="course_status" class="w-full rounded border border-gray-300 p-2 text-sm focus:border-purple-500 focus:outline-none">
                        <option value="DRAFT">Draft</option>
                        <option value="PUBLISHED">Published / purchasable</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Long Description
                    </label>

                    <textarea
                        name="long_description"
                        rows="2"
                        class="w-full rounded border border-gray-300 p-2 text-sm focus:border-purple-500 focus:outline-none resize-y"
                    ></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Default Image Upload
                    </label>

                    <label class="flex flex-col items-center justify-center w-full h-[60px] border-2 border-purple-200 border-dashed rounded cursor-pointer bg-purple-50 hover:bg-purple-100">

                        <p class="text-xs text-gray-500">
                            <span class="font-semibold text-purple-700">
                                Click to upload
                            </span>
                        </p>

                        <input type="file" name="default_image" accept="image/jpeg,image/png,image/webp" class="hidden">
                    </label>
                </div>

            </div>
        </section>


        <!-- Admin-controlled detail/sales page modules -->
        <section class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
            <div class="border-b border-gray-100 pb-4 mb-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-purple-500">Conversion builder</p>
                <h2 class="text-lg font-semibold text-purple-800 mt-1">2. Detail Page Sections</h2>
                <p class="text-xs text-gray-500 mt-1">Only enabled sections are sent to the website or app API. One item per line where requested.</p>
            </div>

            <div class="space-y-4">
                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">Key benefits</p><p class="text-xs text-gray-500">Quick, scannable reasons to buy.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="highlights_enabled" data-module-toggle="highlights_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="highlights_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input name="highlights_heading" maxlength="120" placeholder="Why learners choose this pack" class="rounded border border-gray-300 p-2 text-sm">
                        <textarea name="highlights_items" rows="4" placeholder="Daily exam-ready analysis&#10;Weekly revision capsule&#10;Monthly PDF magazine" class="rounded border border-gray-300 p-2 text-sm"></textarea>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">Exam, language & delivery coverage</p><p class="text-xs text-gray-500">Makes product fit immediately clear.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="coverage_enabled" data-module-toggle="coverage_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="coverage_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input name="coverage_heading" maxlength="120" placeholder="Made for your exam" class="rounded border border-gray-300 p-2 text-sm">
                        <input name="coverage_frequency" maxlength="120" placeholder="Daily updates + weekly and monthly revision" class="rounded border border-gray-300 p-2 text-sm">
                        <textarea name="coverage_exams" rows="4" placeholder="UPSC&#10;SSC CGL&#10;Banking&#10;Railways" class="rounded border border-gray-300 p-2 text-sm"></textarea>
                        <textarea name="coverage_subjects" rows="4" placeholder="Polity & Governance&#10;Economy&#10;Science & Technology&#10;International Relations" class="rounded border border-gray-300 p-2 text-sm"></textarea>
                        <textarea name="coverage_languages" rows="4" placeholder="Hindi&#10;English" class="rounded border border-gray-300 p-2 text-sm"></textarea>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">What learners receive</p><p class="text-xs text-gray-500">Make every deliverable and release frequency concrete.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="deliverables_enabled" data-module-toggle="deliverables_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="deliverables_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input name="deliverables_heading" maxlength="120" placeholder="Everything included in your pack" class="rounded border border-gray-300 p-2 text-sm">
                        <div class="rounded-lg bg-blue-50 border border-blue-100 px-3 py-2 text-xs text-blue-700">One per line: <strong>Title | Description | Frequency</strong></div>
                        <textarea name="deliverables_items" rows="6" placeholder="Daily News Brief | Exam-ready news in simple language | Daily&#10;Current Affairs Quiz | MCQs with explanations | Daily&#10;Monthly Magazine | Complete revision PDF | Monthly" class="md:col-span-2 rounded border border-gray-300 p-2 text-sm"></textarea>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">Free sample preview</p><p class="text-xs text-gray-500">Reduce purchase uncertainty with a safe preview link.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="preview_enabled" data-module-toggle="preview_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="preview_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input name="preview_heading" maxlength="120" placeholder="See what you will receive" class="rounded border border-gray-300 p-2 text-sm">
                        <input type="url" name="preview_url" placeholder="https://.../free-sample" class="rounded border border-gray-300 p-2 text-sm">
                        <textarea name="preview_description" maxlength="800" rows="3" placeholder="Explain what is included in the sample." class="rounded border border-gray-300 p-2 text-sm"></textarea>
                        <input name="preview_cta_label" maxlength="60" placeholder="View free sample" class="rounded border border-gray-300 p-2 text-sm">
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">Smart revision system</p><p class="text-xs text-gray-500">Sell an outcome and routine, not only files.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="revision_enabled" data-module-toggle="revision_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="revision_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input name="revision_heading" maxlength="120" placeholder="Revise in 15 minutes a day" class="rounded border border-gray-300 p-2 text-sm">
                        <input type="number" name="revision_minutes" min="0" max="240" placeholder="Minutes per day" class="rounded border border-gray-300 p-2 text-sm">
                        <textarea name="revision_description" maxlength="800" rows="3" placeholder="Describe the revision workflow." class="rounded border border-gray-300 p-2 text-sm"></textarea>
                        <textarea name="revision_features" rows="4" placeholder="Daily quiz&#10;Bookmark weak topics&#10;7-day recap&#10;Monthly mock" class="rounded border border-gray-300 p-2 text-sm"></textarea>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">Trust & editorial quality</p><p class="text-xs text-gray-500">Show who verifies content and how fresh it is.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="trust_enabled" data-module-toggle="trust_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="trust_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input name="trust_heading" maxlength="120" placeholder="Verified by subject experts" class="rounded border border-gray-300 p-2 text-sm">
                        <input name="trust_expert_name" maxlength="120" placeholder="Editor or faculty name" class="rounded border border-gray-300 p-2 text-sm">
                        <textarea name="trust_source_policy" maxlength="800" rows="3" placeholder="Example: Facts are checked against PIB and official sources." class="rounded border border-gray-300 p-2 text-sm"></textarea>
                        <div class="space-y-3"><input name="trust_update_promise" maxlength="240" placeholder="Updated every day by 7 AM" class="w-full rounded border border-gray-300 p-2 text-sm"><input name="trust_guarantee_text" maxlength="240" placeholder="Refund/access assurance (only if true)" class="w-full rounded border border-gray-300 p-2 text-sm"></div>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">Practice & assessment</p><p class="text-xs text-gray-500">Show measurable practice volume and learning feedback.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="practice_enabled" data-module-toggle="practice_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="practice_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <input name="practice_heading" maxlength="120" placeholder="Practice that improves recall" class="rounded border border-gray-300 p-2 text-sm lg:col-span-2">
                        <input type="number" name="practice_daily_mcqs" min="0" max="10000" placeholder="Daily MCQs" class="rounded border border-gray-300 p-2 text-sm">
                        <input type="number" name="practice_mock_tests" min="0" max="10000" placeholder="Total mock tests" class="rounded border border-gray-300 p-2 text-sm">
                        <label class="rounded-lg border border-gray-200 p-3 text-sm flex items-center gap-2"><input type="checkbox" name="practice_answer_writing" class="accent-purple-600"> Mains answer writing</label>
                        <label class="rounded-lg border border-gray-200 p-3 text-sm flex items-center gap-2"><input type="checkbox" name="practice_analytics" class="accent-purple-600"> Performance analytics</label>
                        <textarea name="practice_description" maxlength="800" rows="3" placeholder="Explain quizzes, solutions, weak-topic tracking, or test pattern." class="rounded border border-gray-300 p-2 text-sm lg:col-span-2"></textarea>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">Faculty & doubt support</p><p class="text-xs text-gray-500">Explain the human support included with the product.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="mentor_enabled" data-module-toggle="mentor_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="mentor_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input name="mentor_heading" maxlength="120" placeholder="Learn with expert guidance" class="rounded border border-gray-300 p-2 text-sm">
                        <input name="mentor_faculty_name" maxlength="120" placeholder="Faculty / editorial team name" class="rounded border border-gray-300 p-2 text-sm">
                        <input name="mentor_experience" maxlength="160" placeholder="Example: 10+ years in competitive exams" class="rounded border border-gray-300 p-2 text-sm">
                        <input name="mentor_support_mode" maxlength="240" placeholder="Example: Weekly live doubt session + Telegram support" class="rounded border border-gray-300 p-2 text-sm">
                        <textarea name="mentor_description" maxlength="800" rows="3" placeholder="Describe response time, doubt channels and what support covers." class="md:col-span-2 rounded border border-gray-300 p-2 text-sm"></textarea>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">FAQ</p><p class="text-xs text-gray-500">Add up to 20 separate question-and-answer blocks.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="faq_enabled" data-module-toggle="faq_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="faq_fields" class="hidden mt-4 space-y-4">
                        <input name="faq_heading" maxlength="120" placeholder="Frequently asked questions" class="w-full rounded border border-gray-300 p-2 text-sm">
                        <div id="faq_rows" class="space-y-3"></div>
                        <button type="button" id="add_faq_button" onclick="addFaqRow()" class="inline-flex items-center gap-2 rounded-lg border border-purple-200 px-4 py-2 text-sm font-semibold text-purple-700 hover:bg-purple-50">
                            + Add another FAQ
                        </button>
                        <p class="text-xs text-gray-500">Each enabled FAQ must contain both fields. Maximum 20 FAQs.</p>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <div><p class="font-semibold text-gray-800">Purchase call-to-action</p><p class="text-xs text-gray-500">Control the final buy panel copy from admin.</p></div>
                        <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="cta_enabled" data-module-toggle="cta_fields" class="h-4 w-4 accent-purple-600"> Enable</label>
                    </div>
                    <div id="cta_fields" class="hidden mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
                        <input name="cta_label" maxlength="60" placeholder="Start preparation" class="rounded border border-gray-300 p-2 text-sm">
                        <input name="cta_subtext" maxlength="240" placeholder="Instant access after payment" class="rounded border border-gray-300 p-2 text-sm">
                        <input name="cta_urgency_text" maxlength="160" placeholder="Offer ends Sunday (avoid fake urgency)" class="rounded border border-gray-300 p-2 text-sm">
                    </div>
                </div>
            </div>
        </section>


        <!-- ===================================================== -->
        <!-- 3. PRICING -->
        <!-- ===================================================== -->

        <section class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">

            <h2 class="text-lg font-semibold text-purple-800 mb-4 border-b border-gray-100 pb-2">
                3. Pricing (Rs)
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                <!-- Price -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Price (₹)
                    </label>

                    <input
                        type="number"
                        name="base_price"
                        min="0"
                        step="0.01"
                        placeholder="0.00"
                        class="w-full rounded border border-gray-300 p-2 text-sm focus:border-purple-500 focus:outline-none"
                    >
                </div>


                <!-- GST -->
                <div>

                    <div class="flex items-center justify-between mb-2">

                        <label class="text-sm font-medium text-gray-700">
                            GST (%)
                        </label>

                        <label class="relative inline-flex items-center cursor-pointer">

                            <input
                                type="checkbox"
                                id="gst_toggle"
                                name="gst_enabled"
                                class="sr-only peer"
                                onchange="togglePricingField('gst_toggle','gst_field')"
                            >

                            <div class="w-10 h-5 bg-gray-300 rounded-full peer
                                peer-checked:bg-purple-600
                                after:content-['']
                                after:absolute after:top-[2px] after:left-[2px]
                                after:bg-white after:rounded-full
                                after:h-4 after:w-4
                                after:transition-all
                                peer-checked:after:translate-x-5">
                            </div>

                        </label>

                    </div>

                    <input
                        id="gst_field"
                        type="number"
                        name="gst_percent"
                        min="0"
                        max="100"
                        step="0.01"
                        placeholder="18"
                        disabled
                        class="w-full rounded border border-gray-300 p-2 text-sm bg-gray-100 focus:border-purple-500 focus:outline-none"
                    >

                </div>


                <!-- Platform Charge -->
                <div>

                    <div class="flex items-center justify-between mb-2">

                        <label class="text-sm font-medium text-gray-700">
                            Platform Charge (₹)
                        </label>

                        <label class="relative inline-flex items-center cursor-pointer">

                            <input
                                type="checkbox"
                                id="platform_toggle"
                                name="platform_charge_enabled"
                                class="sr-only peer"
                                onchange="togglePricingField('platform_toggle','platform_field')"
                            >

                            <div class="w-10 h-5 bg-gray-300 rounded-full peer
                                peer-checked:bg-purple-600
                                after:content-['']
                                after:absolute after:top-[2px] after:left-[2px]
                                after:bg-white after:rounded-full
                                after:h-4 after:w-4
                                after:transition-all
                                peer-checked:after:translate-x-5">
                            </div>

                        </label>

                    </div>

                    <input
                        id="platform_field"
                        type="number"
                        name="platform_charge"
                        min="0"
                        step="0.01"
                        placeholder="0.00"
                        disabled
                        class="w-full rounded border border-gray-300 p-2 text-sm bg-gray-100 focus:border-purple-500 focus:outline-none"
                    >

                </div>

            </div>
        </section>


        <!-- ===================================================== -->
        <!-- 4. GK STARTED -->
        <!-- ===================================================== -->

        <section class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">

            <div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-2">

                <h2 class="text-lg font-semibold text-purple-800">
                    4. GK Started
                </h2>

                <span class="text-xs text-gray-400">
                    Choose either Coming Soon or Ads
                </span>

            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">

                <!-- Start Date -->
                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Start Date
                    </label>

                    <input
                        type="date"
                        name="course_start_date"
                        class="w-full rounded border border-gray-300 p-2 text-sm focus:border-purple-500 focus:outline-none"
                    >

                </div>


                <!-- End Date -->
                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        End Date
                    </label>

                    <input
                        type="date"
                        name="course_end_date"
                        class="w-full rounded border border-gray-300 p-2 text-sm focus:border-purple-500 focus:outline-none"
                    >

                </div>

            </div>


            <!-- Toggle Area -->
            <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">

                <!-- Coming Soon -->
                <div class="flex items-center justify-between p-4 rounded-lg border border-gray-200 bg-gray-50">

                    <div>
                        <p class="text-sm font-semibold text-gray-800">
                            Coming Soon
                        </p>

                        <p class="text-xs text-gray-500 mt-1">
                            Show course as coming soon
                        </p>
                    </div>

                    <label class="relative inline-flex items-center cursor-pointer">

                        <input
                            type="checkbox"
                            id="coming_soon_toggle"
                            name="coming_soon"
                            class="sr-only peer"
                            onchange="toggleGKOption('coming')"
                        >

                        <div class="w-11 h-6 bg-gray-300 rounded-full
                            peer-checked:bg-purple-600
                            after:content-['']
                            after:absolute after:top-[2px] after:left-[2px]
                            after:bg-white after:rounded-full
                            after:h-5 after:w-5
                            after:transition-all
                            peer-checked:after:translate-x-5">
                        </div>

                    </label>

                </div>


                <!-- Ads -->
                <div class="flex items-center justify-between p-4 rounded-lg border border-gray-200 bg-gray-50">

                    <div>
                        <p class="text-sm font-semibold text-gray-800">
                            Ads
                        </p>

                        <p class="text-xs text-gray-500 mt-1">
                            Enable advertisement setup
                        </p>
                    </div>

                    <label class="relative inline-flex items-center cursor-pointer">

                        <input
                            type="checkbox"
                            id="main_ads_toggle"
                            name="ads_enabled"
                            class="sr-only peer"
                            onchange="toggleGKOption('ads')"
                        >

                        <div class="w-11 h-6 bg-gray-300 rounded-full
                            peer-checked:bg-purple-600
                            after:content-['']
                            after:absolute after:top-[2px] after:left-[2px]
                            after:bg-white after:rounded-full
                            after:h-5 after:w-5
                            after:transition-all
                            peer-checked:after:translate-x-5">
                        </div>

                    </label>

                </div>

            </div>

        </section>


        <!-- ===================================================== -->
        <!-- 5. ADS SETUP -->
        <!-- ===================================================== -->

        <section
            id="ads_setup_section"
            class="hidden bg-white rounded-lg shadow-sm p-6 border border-gray-200"
        >

            <h2 class="text-lg font-semibold text-purple-800 mb-4 border-b border-gray-100 pb-2">
                5. Ads Setup
            </h2>


            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 items-end">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Start Date
                    </label>

                    <input
                        type="date"
                        name="ad_start_date"
                        class="w-full rounded border border-gray-300 p-2 text-sm"
                    >
                </div>


                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        End Date
                    </label>

                    <input
                        type="date"
                        name="ad_end_date"
                        class="w-full rounded border border-gray-300 p-2 text-sm"
                    >
                </div>


                <!-- Ads Image -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Ads Image
                    </label>

                    <input
                        type="file"
                        name="ad_image"
                        accept="image/*"
                        class="w-full text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-700 border border-gray-300 rounded cursor-pointer"
                    >
                </div>


                <!-- Link Type -->
                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Select Link Type
                    </label>

                    <div class="flex gap-4">

                        <label class="flex items-center gap-2 cursor-pointer">
                            <input
                                type="radio"
                                name="link_type"
                                value="image"
                                onchange="toggleAdsFields()"
                            >
                            <span class="text-sm">Image</span>
                        </label>

                        <label class="flex items-center gap-2 cursor-pointer">
                            <input
                                type="radio"
                                name="link_type"
                                value="button"
                                onchange="toggleAdsFields()"
                            >
                            <span class="text-sm">Button</span>
                        </label>

                        <label class="flex items-center gap-2 cursor-pointer">
                            <input
                                type="radio"
                                name="link_type"
                                value="both"
                                onchange="toggleAdsFields()"
                            >
                            <span class="text-sm">Both</span>
                        </label>

                    </div>

                </div>


                <!-- Image URL -->
                <div id="image_url_wrapper" class="hidden">

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Image URL
                    </label>

                    <input
                        type="url"
                        name="image_url"
                        placeholder="https://"
                        class="w-full rounded border border-gray-300 p-2 text-sm"
                    >

                </div>


                <!-- Button URL -->
                <div id="button_url_wrapper" class="hidden">

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Button URL
                    </label>

                    <input
                        type="url"
                        name="button_url"
                        placeholder="https://"
                        class="w-full rounded border border-gray-300 p-2 text-sm"
                    >

                </div>

            </div>

        </section>


        <!-- ===================================================== -->
        <!-- 6. NOTIFICATION -->
        <!-- ===================================================== -->

        <section class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">

            <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5">

                <div>
                    <h2 class="text-lg font-semibold text-purple-800">
                        6. Notification
                    </h2>

                    <p class="text-xs text-gray-500 mt-1">
                        Turn notification on only when you want to show it.
                    </p>
                </div>


                <!-- Notification Toggle -->
                <div class="flex items-center gap-3">

                    <span
                        id="notification_status"
                        class="text-xs font-medium text-gray-500"
                    >
                        OFF
                    </span>

                    <label class="relative inline-flex items-center cursor-pointer">

                        <input
                            type="checkbox"
                            id="notification_toggle"
                            name="notification_enabled"
                            class="sr-only peer"
                            onchange="toggleNotificationFields()"
                        >

                        <div class="w-12 h-6 bg-gray-300 rounded-full
                            peer-checked:bg-purple-600
                            after:content-['']
                            after:absolute after:top-[2px] after:left-[2px]
                            after:bg-white after:rounded-full
                            after:h-5 after:w-5
                            after:transition-all
                            peer-checked:after:translate-x-6">
                        </div>

                    </label>

                </div>

            </div>


            <div
                id="notification_fields"
                class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"
            >

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Title
                    </label>

                    <input
                        type="text"
                        name="notification_title"
                        class="w-full rounded border border-gray-300 p-2 text-sm"
                    >
                </div>


                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Description
                    </label>

                    <textarea
                        name="notification_description"
                        rows="1"
                        class="w-full rounded border border-gray-300 p-2 text-sm resize-y"
                    ></textarea>
                </div>


                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Start Date
                    </label>

                    <input
                        type="date"
                        name="notification_start_date"
                        class="w-full rounded border border-gray-300 p-2 text-sm"
                    >
                </div>


                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        End Date
                    </label>

                    <input
                        type="date"
                        name="notification_end_date"
                        class="w-full rounded border border-gray-300 p-2 text-sm"
                    >
                </div>

            </div>


            <div
                id="notification_submit"
                class="hidden mt-4"
            >

                <button
                    type="button"
                    class="bg-purple-700 text-white font-medium px-5 py-2 rounded hover:bg-purple-800 text-sm"
                >
                    Submit Notification
                </button>

            </div>

        </section>


        <!-- ===================================================== -->
        <!-- 8. UPLOAD -->
        <!-- ===================================================== -->

        <section class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">

            <h2 class="text-lg font-semibold text-purple-800 mb-4 border-b border-gray-100 pb-2">
                8. Upload
            </h2>


            <div class="mb-4">

                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Choose Upload Type
                </label>


                <div class="flex gap-6">

                    <!-- MASTER PDF -->
                    <label class="flex items-center gap-2 cursor-pointer">

                        <input
                            type="radio"
                            name="upload_type"
                            value="master_pdf"
                            class="w-4 h-4 text-purple-600"
                            onchange="toggleUploadFields()"
                        >

                        <span class="text-sm text-gray-700">
                            Master PDF
                        </span>

                    </label>


                    <!-- NORMAL PDF -->
                    <label class="flex items-center gap-2 cursor-pointer">

                        <input
                            type="radio"
                            name="upload_type"
                            value="normal_pdf"
                            class="w-4 h-4 text-purple-600"
                            onchange="toggleUploadFields()"
                        >

                        <span class="text-sm text-gray-700">
                            Normal PDF
                        </span>

                    </label>

                </div>

            </div>


            <!-- MASTER PDF -->
            <div
                id="master_pdf_wrapper"
                class="hidden"
            >

                <div class="rounded-lg border border-purple-200 bg-purple-50 p-5">

                    <div class="flex items-center gap-3">

                        <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center">
                            <span class="text-purple-700 font-bold">
                                ✓
                            </span>
                        </div>

                        <div>

                            <p class="text-sm font-semibold text-purple-800">
                                Master PDF
                            </p>

                            <p class="text-sm text-purple-700 mt-1">
                                In Service
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- NORMAL PDF -->
            <div
                id="normal_pdf_wrapper"
                class="hidden grid-cols-1 md:grid-cols-2 gap-4 items-end"
            >

                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        PDF Name
                    </label>

                    <input
                        type="text"
                        name="pdf_name"
                        placeholder="Enter PDF name"
                        class="w-full rounded border border-gray-300 p-2 text-sm"
                    >

                </div>


                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Upload PDF
                    </label>

                    <input
                        type="file"
                        name="normal_pdf"
                        accept=".pdf,application/pdf"
                        class="w-full text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-700 border border-gray-300 rounded cursor-pointer"
                    >

                </div>

            </div>

        </section>


        <!-- ===================================================== -->
        <!-- 9. OFFER -->
        <!-- ===================================================== -->

        <section class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">

            <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5">

                <div>
                    <h2 class="text-lg font-semibold text-purple-800">
                        9. Offer
                    </h2>

                    <p class="text-xs text-gray-500 mt-1">
                        Enable offer when required.
                    </p>
                </div>


                <!-- Offer Toggle -->
                <label class="relative inline-flex items-center cursor-pointer">

                    <input
                        type="checkbox"
                        id="offer_toggle"
                        name="offer_enabled"
                        class="sr-only peer"
                        onchange="toggleOfferFields()"
                    >

                    <div class="w-12 h-6 bg-gray-300 rounded-full
                        peer-checked:bg-purple-600
                        after:content-['']
                        after:absolute after:top-[2px] after:left-[2px]
                        after:bg-white after:rounded-full
                        after:h-5 after:w-5
                        after:transition-all
                        peer-checked:after:translate-x-6">
                    </div>

                </label>

            </div>


            <div
                id="offer_fields"
                class="hidden"
            >

                <!-- Offer Name -->
                <div class="mb-5 max-w-md">

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Offer Name
                    </label>

                    <input
                        type="text"
                        name="offer_name"
                        placeholder="Enter Offer Name"
                        class="w-full rounded-lg border border-gray-300 p-3 text-sm focus:border-purple-500 focus:outline-none"
                    >

                </div>


                <!-- Choose Discount -->
                <div>

                    <input type="hidden" id="offer_type" name="offer_type">

                    <label class="block text-sm font-medium text-gray-700 mb-3">
                        Discount Type
                    </label>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl">

                        <!-- PERCENT -->
                        <button
                            type="button"
                            id="percent_option"
                            onclick="selectOfferType('percent')"
                            class="offer-type border-2 border-gray-200 rounded-xl p-5 text-left hover:border-purple-300 transition-all"
                        >

                            <div class="flex items-center justify-between">

                                <div>

                                    <p class="text-lg font-bold text-gray-800">
                                        Percentage
                                    </p>

                                    <p class="text-xs text-gray-500 mt-1">
                                        Discount in %
                                    </p>

                                </div>

                                <div class="text-2xl font-bold text-purple-600">
                                    %
                                </div>

                            </div>

                        </button>


                        <!-- RUPEES -->
                        <button
                            type="button"
                            id="rs_option"
                            onclick="selectOfferType('rs')"
                            class="offer-type border-2 border-gray-200 rounded-xl p-5 text-left hover:border-purple-300 transition-all"
                        >

                            <div class="flex items-center justify-between">

                                <div>

                                    <p class="text-lg font-bold text-gray-800">
                                        Fixed Amount
                                    </p>

                                    <p class="text-xs text-gray-500 mt-1">
                                        Discount in ₹
                                    </p>

                                </div>

                                <div class="text-2xl font-bold text-purple-600">
                                    ₹
                                </div>

                            </div>

                        </button>

                    </div>

                </div>


                <!-- RATE BOX -->
                <div
                    id="offer_rate_wrapper"
                    class="hidden mt-5 max-w-md"
                >

                    <label
                        id="offer_rate_label"
                        class="block text-sm font-medium text-gray-700 mb-1"
                    >
                        Rate
                    </label>

                    <div class="relative">

                        <span
                            id="offer_rate_symbol"
                            class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold"
                        >
                        </span>

                        <input
                            type="number"
                            id="offer_rate"
                            name="offer_rate"
                            min="0"
                            step="0.01"
                            placeholder="Enter rate"
                            class="w-full rounded-lg border border-gray-300 p-3 pl-9 text-sm focus:border-purple-500 focus:outline-none"
                        >

                    </div>

                </div>


                <!-- APPLY -->
                <div
                    id="offer_apply_wrapper"
                    class="hidden mt-5"
                >

                    <button
                        type="button"
                        class="bg-purple-700 text-white font-medium px-6 py-2.5 rounded-lg hover:bg-purple-800 text-sm"
                    >
                        Apply
                    </button>

                </div>

            </div>

        </section>


        <div class="flex justify-end gap-3 pb-10">
            <a href="/current-affairs"
               class="border border-gray-300 text-gray-700 font-semibold px-7 py-3 rounded-lg hover:bg-gray-100 transition">
                Cancel
            </a>
            <button
                type="submit"
                class="bg-purple-700 text-white font-semibold px-7 py-3 rounded-lg hover:bg-purple-800 transition"
            >
                <%= typeof courseId !== 'undefined' && courseId ? 'Update' : 'Save' %> Current Affairs Course
            </button>
        </div>

    </form>

</div>


<script>

    /* =========================================================
       3. GST / PLATFORM
    ========================================================= */

    function togglePricingField(toggleId, fieldId) {

        const toggle = document.getElementById(toggleId);
        const field = document.getElementById(fieldId);

        if (toggle.checked) {

            field.disabled = false;
            field.classList.remove("bg-gray-100");

        } else {

            field.disabled = true;
            field.value = "";
            field.classList.add("bg-gray-100");

        }
    }


    /* =========================================================
       4. COMING SOON / ADS
       ONLY ONE CAN BE ON
    ========================================================= */

    function toggleGKOption(type) {

        const comingSoon =
            document.getElementById("coming_soon_toggle");

        const ads =
            document.getElementById("main_ads_toggle");

        const adsSection =
            document.getElementById("ads_setup_section");


        if (type === "coming" && comingSoon.checked) {

            ads.checked = false;

            adsSection.classList.add("hidden");

        }


        if (type === "ads" && ads.checked) {

            comingSoon.checked = false;

            adsSection.classList.remove("hidden");

        }


        if (!ads.checked) {

            adsSection.classList.add("hidden");

        }

    }


    /* =========================================================
       5. ADS LINK TYPE
    ========================================================= */

    function toggleAdsFields() {

        const linkType =
            document.querySelector(
                'input[name="link_type"]:checked'
            )?.value;

        const imageWrapper =
            document.getElementById("image_url_wrapper");

        const buttonWrapper =
            document.getElementById("button_url_wrapper");


        imageWrapper.classList.add("hidden");
        buttonWrapper.classList.add("hidden");


        if (linkType === "image") {

            imageWrapper.classList.remove("hidden");

        }

        if (linkType === "button") {

            buttonWrapper.classList.remove("hidden");

        }

        if (linkType === "both") {

            imageWrapper.classList.remove("hidden");
            buttonWrapper.classList.remove("hidden");

        }

    }


    /* =========================================================
       6. NOTIFICATION
    ========================================================= */

    function toggleNotificationFields() {

        const toggle =
            document.getElementById("notification_toggle");

        const fields =
            document.getElementById("notification_fields");

        const submit =
            document.getElementById("notification_submit");

        const status =
            document.getElementById("notification_status");


        if (toggle.checked) {

            fields.classList.remove("hidden");
            fields.classList.add("grid");

            submit.classList.remove("hidden");

            status.innerText = "ON";
            status.classList.remove("text-gray-500");
            status.classList.add("text-purple-600");

        } else {

            fields.classList.add("hidden");
            fields.classList.remove("grid");

            submit.classList.add("hidden");

            status.innerText = "OFF";
            status.classList.remove("text-purple-600");
            status.classList.add("text-gray-500");

        }

    }


    /* =========================================================
       8. UPLOAD
       MASTER PDF = IN SERVICE
    ========================================================= */

    function toggleUploadFields() {

        const uploadType =
            document.querySelector(
                'input[name="upload_type"]:checked'
            )?.value;

        const masterWrapper =
            document.getElementById("master_pdf_wrapper");

        const normalWrapper =
            document.getElementById("normal_pdf_wrapper");


        masterWrapper.classList.add("hidden");

        normalWrapper.classList.add("hidden");
        normalWrapper.classList.remove("grid");


        if (uploadType === "master_pdf") {

            masterWrapper.classList.remove("hidden");

        }


        if (uploadType === "normal_pdf") {

            normalWrapper.classList.remove("hidden");
            normalWrapper.classList.add("grid");

        }

    }


    /* =========================================================
       9. OFFER
    ========================================================= */

    function toggleOfferFields() {

        const toggle =
            document.getElementById("offer_toggle");

        const fields =
            document.getElementById("offer_fields");


        if (toggle.checked) {

            fields.classList.remove("hidden");

        } else {

            fields.classList.add("hidden");

        }

    }


    /* =========================================================
       9. OFFER TYPE
       % OR ₹ ATTRACTIVE BOX
    ========================================================= */

    function selectOfferType(type) {

        document.getElementById("offer_type").value =
            type === "percent" ? "PERCENT" : "FIXED";

        const percentOption =
            document.getElementById("percent_option");

        const rsOption =
            document.getElementById("rs_option");

        const rateWrapper =
            document.getElementById("offer_rate_wrapper");

        const applyWrapper =
            document.getElementById("offer_apply_wrapper");

        const rateLabel =
            document.getElementById("offer_rate_label");

        const rateSymbol =
            document.getElementById("offer_rate_symbol");

        const rateInput =
            document.getElementById("offer_rate");


        /* Reset */
        percentOption.classList.remove(
            "border-purple-600",
            "bg-purple-50"
        );

        rsOption.classList.remove(
            "border-purple-600",
            "bg-purple-50"
        );


        /* Show Rate + Apply */
        rateWrapper.classList.remove("hidden");
        applyWrapper.classList.remove("hidden");


        if (type === "percent") {

            percentOption.classList.add(
                "border-purple-600",
                "bg-purple-50"
            );

            rateLabel.innerText = "Discount Rate (%)";
            rateSymbol.innerText = "%";
            rateInput.placeholder = "Enter percentage";

        }


        if (type === "rs") {

            rsOption.classList.add(
                "border-purple-600",
                "bg-purple-50"
            );

            rateLabel.innerText = "Discount Rate (₹)";
            rateSymbol.innerText = "₹";
            rateInput.placeholder = "Enter amount";

        }

    }

    function addFaqRow(question = "", answer = "") {
        const container = document.getElementById("faq_rows");
        if (!container || container.children.length >= 20) return;

        const row = document.createElement("div");
        row.className = "grid grid-cols-1 md:grid-cols-[1fr_2fr_auto] gap-3 rounded-xl border border-gray-200 bg-gray-50 p-3";

        const questionInput = document.createElement("input");
        questionInput.name = "faq_question[]";
        questionInput.maxLength = 220;
        questionInput.placeholder = "Question";
        questionInput.className = "rounded border border-gray-300 bg-white p-2 text-sm";
        questionInput.value = question;

        const answerInput = document.createElement("textarea");
        answerInput.name = "faq_answer[]";
        answerInput.maxLength = 1000;
        answerInput.rows = 2;
        answerInput.placeholder = "Answer";
        answerInput.className = "rounded border border-gray-300 bg-white p-2 text-sm";
        answerInput.value = answer;

        const removeButton = document.createElement("button");
        removeButton.type = "button";
        removeButton.textContent = "Remove";
        removeButton.className = "self-start rounded-lg border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50";
        removeButton.addEventListener("click", () => row.remove());

        row.append(questionInput, answerInput, removeButton);
        container.append(row);
    }

    const initialFormData = <%- JSON.stringify(typeof formData !== 'undefined' ? formData : {}).replace(/</g, '\\u003c') %>;

    Object.entries(initialFormData).forEach(([name, rawValue]) => {
        const fields = document.querySelectorAll(`[name="${CSS.escape(name)}"]`);
        fields.forEach((field) => {
            if (field.type === "file") return;
            if (field.type === "checkbox") {
                field.checked = rawValue === true || rawValue === "on" || rawValue === "1" || rawValue === 1;
            } else if (field.type === "radio") {
                field.checked = String(field.value).toLowerCase() === String(rawValue || "").toLowerCase();
            } else if (rawValue !== null && rawValue !== undefined) {
                field.value = rawValue;
            }
        });
    });

    const initialQuestions = Array.isArray(initialFormData.faq_question)
        ? initialFormData.faq_question
        : (initialFormData.faq_question === undefined ? [] : [initialFormData.faq_question]);
    const initialAnswers = Array.isArray(initialFormData.faq_answer)
        ? initialFormData.faq_answer
        : (initialFormData.faq_answer === undefined ? [] : [initialFormData.faq_answer]);

    if (initialQuestions.length || initialAnswers.length) {
        Array.from({ length: Math.max(initialQuestions.length, initialAnswers.length) }, (_, index) => {
            addFaqRow(initialQuestions[index] || "", initialAnswers[index] || "");
        });
    } else if (typeof initialFormData.faq_items === "string" && initialFormData.faq_items.trim()) {
        initialFormData.faq_items.split(/\r?\n/).forEach((line) => {
            const separator = line.indexOf("|");
            addFaqRow(
                separator >= 0 ? line.slice(0, separator).trim() : line.trim(),
                separator >= 0 ? line.slice(separator + 1).trim() : ""
            );
        });
    } else {
        addFaqRow();
    }

    document.querySelectorAll("[data-module-toggle]").forEach((toggle) => {
        const fields = document.getElementById(toggle.dataset.moduleToggle);
        const syncModule = () => fields?.classList.toggle("hidden", !toggle.checked);
        toggle.addEventListener("change", syncModule);
        syncModule();
    });

    togglePricingField("gst_toggle", "gst_field");
    togglePricingField("platform_toggle", "platform_field");
    toggleGKOption("ads");
    toggleAdsFields();
    toggleNotificationFields();
    toggleUploadFields();
    toggleOfferFields();
    if (["PERCENT", "FIXED"].includes(String(initialFormData.offer_type || "").toUpperCase())) {
        selectOfferType(String(initialFormData.offer_type).toUpperCase() === "PERCENT" ? "percent" : "rs");
    }

</script>

</body>
</html>

