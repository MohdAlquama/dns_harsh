<div class="max-w mx-auto space-y-6">
  <div>
    <p class="text-sm font-semibold text-violet-600">Accounts</p>
    <h1 class="text-2xl font-bold text-slate-900 mt-1">Website users</h1>
    <p class="text-sm text-slate-500 mt-1">Users registered through the website authentication API.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">All users</p><p class="mt-2 text-2xl font-bold text-slate-900"><%= summary.total.toLocaleString('en-IN') %></p></div>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5"><p class="text-sm text-emerald-700">Active</p><p class="mt-2 text-2xl font-bold text-emerald-800"><%= summary.active.toLocaleString('en-IN') %></p></div>
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5"><p class="text-sm text-amber-700">Inactive / unverified</p><p class="mt-2 text-2xl font-bold text-amber-800"><%= summary.inactive.toLocaleString('en-IN') %></p></div>
  </div>

  <section class="rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden">
    <form method="GET" action="/users" class="flex flex-col gap-3 border-b border-slate-200 p-4 sm:flex-row sm:items-end">
      <label class="flex-1 text-sm font-medium text-slate-700">Search
        <input type="search" name="search" value="<%= filters.search %>" placeholder="Name or phone number" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-100">
      </label>
      <label class="text-sm font-medium text-slate-700">Status
        <select name="status" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5 sm:w-44">
          <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All statuses</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive / unverified</option>
        </select>
      </label>
      <label class="text-sm font-medium text-slate-700">Per page
        <select name="pageSize" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5 sm:w-28">
          <% [10, 20, 50, 100].forEach((size) => { %><option value="<%= size %>" <%= filters.pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %>
        </select>
      </label>
      <button class="rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white hover:bg-violet-700">Apply</button>
      <% if (filters.search || filters.status !== 'all' || filters.pageSize !== 20) { %><a href="/users" class="rounded-xl border border-slate-300 px-5 py-2.5 text-center font-semibold text-slate-600 hover:bg-slate-50">Clear</a><% } %>
    </form>

    <% if (!users.length) { %>
      <div class="py-16 text-center"><i data-lucide="users" class="mx-auto h-10 w-10 text-slate-300"></i><p class="mt-3 font-medium text-slate-600">No users match these filters.</p></div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-500"><tr><th class="p-4">User</th><th class="p-4">Phone number</th><th class="p-4">Status</th><th class="p-4">Registered</th><th class="p-4">Last updated</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            <% users.forEach((user) => { %><tr class="hover:bg-slate-50/60">
              <td class="p-4"><p class="font-semibold text-slate-800"><%= user.name %></p><p class="mt-1 text-xs text-slate-400">User #<%= user.id %></p></td>
              <td class="p-4 font-medium text-slate-700"><%= user.phone_number %></td>
              <td class="p-4"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-bold <%= user.status ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>"><%= user.status ? 'Active' : 'Inactive / unverified' %></span></td>
              <td class="p-4 whitespace-nowrap text-xs text-slate-500"><%= new Date(user.created_at).toLocaleString('en-IN') %></td>
              <td class="p-4 whitespace-nowrap text-xs text-slate-500"><%= new Date(user.updated_at).toLocaleString('en-IN') %></td>
            </tr><% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="flex flex-col gap-3 border-t border-slate-200 p-4 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p class="text-slate-500">Showing <span class="font-semibold text-slate-700"><%= pagination.from %>–<%= pagination.to %></span> of <span class="font-semibold text-slate-700"><%= pagination.total.toLocaleString('en-IN') %></span></p>
      <% if (pagination.pageCount > 1) { %><nav aria-label="User list pagination" class="flex flex-wrap items-center gap-1">
        <% if (pagination.previousUrl) { %><a href="<%= pagination.previousUrl %>" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-600 hover:bg-slate-50">Previous</a><% } %>
        <% pagination.pages.forEach((item) => { %><a href="<%= item.url %>" aria-current="<%= item.page === pagination.page ? 'page' : 'false' %>" class="rounded-lg px-3 py-2 <%= item.page === pagination.page ? 'bg-violet-600 font-semibold text-white' : 'border border-slate-300 text-slate-600 hover:bg-slate-50' %>"><%= item.page %></a><% }) %>
        <% if (pagination.nextUrl) { %><a href="<%= pagination.nextUrl %>" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-600 hover:bg-slate-50">Next</a><% } %>
      </nav><% } %>
    </div>
  </section>
</div>
