<div class="max-w-6xl mx-auto space-y-6">

  <!-- Header -->
  <div>
    <p class="text-sm font-semibold text-violet-600">
      Super admin
    </p>

    <h1 class="text-2xl font-bold text-slate-900 mt-1">
      Administrators
    </h1>

    <p class="text-sm text-slate-500 mt-1">
      Create and manage administrators.
      Every new login requires password and OTP.
    </p>
  </div>


  <!-- Success: Created -->
  <% if (saved) { %>

    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-700">

      Administrator created successfully.

    </div>

  <% } %>


  <!-- Success: Deleted -->
  <% if (deleted) { %>

    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-700">

      Administrator deleted successfully.

    </div>

  <% } %>


  <!-- Error -->
  <% if (error) { %>

    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">

      <%= error %>

    </div>

  <% } %>


  <div class="grid lg:grid-cols-3 gap-6">


    <!-- CREATE ADMIN -->
    <form
      method="POST"
      action="/admins"
      class="bg-white border border-slate-200 rounded-3xl p-6 space-y-4 h-fit"
    >

      <div>

        <h2 class="font-bold text-slate-900">
          Add administrator
        </h2>

        <p class="text-xs text-slate-500 mt-1">
          Choose whether this account is Admin or Super Admin.
        </p>

      </div>


      <!-- Name -->
      <div>

        <label class="block text-sm font-semibold text-slate-700 mb-2">
          Full name
        </label>

        <input
          name="name"
          required
          placeholder="Full name"
          class="w-full rounded-xl border border-slate-300 p-3 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-100"
        >

      </div>


      <!-- Phone -->
      <div>

        <label class="block text-sm font-semibold text-slate-700 mb-2">
          Phone number
        </label>

        <input
          name="phoneNumber"
          inputmode="numeric"
          maxlength="10"
          minlength="10"
          pattern="[0-9]{10}"
          required
          placeholder="10-digit phone"
          class="w-full rounded-xl border border-slate-300 p-3 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-100"
        >

      </div>


      <!-- Password -->
      <div>

        <label class="block text-sm font-semibold text-slate-700 mb-2">
          Temporary password
        </label>

        <input
          type="password"
          name="password"
          minlength="8"
          required
          placeholder="Minimum 8 characters"
          class="w-full rounded-xl border border-slate-300 p-3 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-100"
        >

      </div>


      <!-- ROLE -->
      <div>

        <label class="block text-sm font-semibold text-slate-700 mb-2">
          Role
        </label>

        <select
          name="role"
          required
          class="w-full rounded-xl border border-slate-300 p-3 bg-white outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-100"
        >

          <option value="ADMIN">
            Admin
          </option>

          <option value="SUPER_ADMIN">
            Super Admin
          </option>

        </select>

      </div>


      <!-- Button -->
      <button
        type="submit"
        class="w-full rounded-xl bg-violet-600 py-3 text-white font-semibold hover:bg-violet-700 transition"
      >

        Create administrator

      </button>

    </form>


    <!-- ADMIN LIST -->
    <section
      class="lg:col-span-2 bg-white border border-slate-200 rounded-3xl overflow-hidden"
    >

      <div class="overflow-x-auto">

        <table class="w-full text-sm min-w-[760px]">


          <!-- TABLE HEADER -->
          <thead
            class="bg-slate-50 text-left text-slate-500"
          >

            <tr>

              <th class="p-4">
                Administrator
              </th>

              <th class="p-4">
                Role
              </th>

              <th class="p-4">
                Status
              </th>

              <th class="p-4">
                Created
              </th>

              <th class="p-4 text-right">
                Action
              </th>

            </tr>

          </thead>


          <!-- TABLE BODY -->
          <tbody
            class="divide-y divide-slate-100"
          >

            <% admins.forEach((item) => { %>

              <tr
                id="admin-<%= item.id %>"
                class="target:bg-violet-50 hover:bg-slate-50 transition"
              >


                <!-- ADMIN -->
                <td class="p-4">

                  <p class="font-semibold text-slate-800">
                    <%= item.name %>
                  </p>

                  <p class="text-xs text-slate-500 mt-1">
                    <%= item.phone_number %>
                  </p>

                </td>


                <!-- ROLE -->
                <td class="p-4">

                  <% if (item.role === "SUPER_ADMIN") { %>

                    <span
                      class="inline-flex rounded-full px-3 py-1 text-xs font-semibold bg-violet-100 text-violet-700"
                    >
                      SUPER ADMIN
                    </span>

                  <% } else { %>

                    <span
                      class="inline-flex rounded-full px-3 py-1 text-xs font-semibold bg-slate-100 text-slate-700"
                    >
                      ADMIN
                    </span>

                  <% } %>

                </td>


                <!-- STATUS -->
                <td class="p-4">

                  <% if (item.status) { %>

                    <span
                      class="rounded-full px-3 py-1 text-xs font-bold bg-emerald-100 text-emerald-700"
                    >
                      Active
                    </span>

                  <% } else { %>

                    <span
                      class="rounded-full px-3 py-1 text-xs font-bold bg-slate-100 text-slate-500"
                    >
                      Disabled
                    </span>

                  <% } %>

                </td>


                <!-- CREATED -->
                <td class="p-4 text-xs text-slate-500">

                  <%= new Date(
                    item.created_at
                  ).toLocaleDateString(
                    'en-IN'
                  ) %>

                </td>


                <!-- DELETE -->
                <td class="p-4 text-right">

                  <% if (
                    Number(item.id) !==
                    Number(currentAdminId)
                  ) { %>

                    <form
                      method="POST"
                      action="/admins/<%= item.id %>/delete"
                      onsubmit="return confirm('Are you sure you want to delete this administrator? Their active login sessions will also be removed.');"
                    >

                      <button
                        type="submit"
                        class="inline-flex items-center justify-center rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-100 transition"
                      >

                        Delete

                      </button>

                    </form>

                  <% } else { %>

                    <span class="text-xs text-slate-400">
                      Current account
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </section>

  </div>

</div>