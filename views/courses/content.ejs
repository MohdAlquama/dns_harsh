<div class="p-6 md:p-8 max-w-6xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-7">

        <div>

            <a
                href="/courses"
                class="text-sm text-violet-600 hover:underline"
            >
                ← Back to Courses
            </a>

            <h1 class="text-2xl font-bold text-slate-900 mt-3">
                Select Course Videos
            </h1>

            <p class="text-sm text-slate-500 mt-1">
                <%= course.course_name %>
            </p>

        </div>


        <div class="rounded-xl bg-slate-100 px-4 py-2 text-sm text-slate-600">

            Subject:

            <b class="text-slate-900">
                <%= course.subject_name %>
            </b>

        </div>

    </div>


    <% if (typeof saved !== "undefined" && saved) { %>

        <div class="mb-5 rounded-xl bg-emerald-50 border border-emerald-200 p-4 text-sm text-emerald-700">
            Course videos saved successfully.
        </div>

    <% } %>


    <form
        action="/courses/<%= course.id %>/content"
        method="POST"
    >

        <div class="space-y-5">


            <% if (!chapters.length) { %>

                <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">

                    <h2 class="font-semibold text-amber-900">
                        No chapters found
                    </h2>

                    <p class="text-sm text-amber-700 mt-1">
                        Is subject ke andar pehle chapters aur videos create karo.
                    </p>

                </div>

            <% } %>


            <% chapters.forEach((chapter) => { %>


                <section class="rounded-2xl border border-slate-200 bg-white overflow-hidden">


                    <!-- CHAPTER HEADER -->

                    <div class="flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-5 py-4">

                        <div>

                            <h2 class="font-bold text-slate-900">
                                <%= chapter.folder_name %>
                            </h2>

                            <p class="text-xs text-slate-500 mt-1">
                                <%= chapter.videos.length %> video(s)
                            </p>

                        </div>


                        <button
                            type="button"
                            onclick="toggleChapter('<%= chapter.id %>')"
                            class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
                        >
                            Select All
                        </button>

                    </div>


                    <!-- VIDEOS -->

                    <div
                        id="chapter-<%= chapter.id %>"
                        class="divide-y divide-slate-100"
                    >


                        <% if (!chapter.videos.length) { %>

                            <div class="p-5 text-sm text-slate-500">
                                Is chapter mein koi video nahi hai.
                            </div>

                        <% } %>


                        <% chapter.videos.forEach((video) => { %>


                            <label class="flex gap-4 p-5 cursor-pointer hover:bg-slate-50">


                                <input
                                    type="checkbox"
                                    name="video_ids"
                                    value="<%= video.id %>"
                                    <%= selectedVideoIds.includes(Number(video.id))
                                        ? "checked"
                                        : "" %>
                                    class="mt-1 h-4 w-4 rounded border-slate-300 text-violet-600"
                                >


                                <div class="min-w-0 flex-1">

                                    <div class="font-semibold text-slate-900">
                                        <%= video.video_name %>
                                    </div>


                                    <% if (video.video_description) { %>

                                        <p class="text-sm text-slate-500 mt-1">
                                            <%= video.video_description %>
                                        </p>

                                    <% } %>


                                    <p class="text-xs text-slate-400 mt-2 break-all">
                                        <%= video.s3_key %>
                                    </p>

                                </div>


                            </label>


                        <% }) %>


                    </div>

                </section>


            <% }) %>

        </div>


        <div class="flex justify-end mt-6">

            <button
                type="submit"
                class="rounded-xl bg-violet-600 px-7 py-3 text-sm font-semibold text-white hover:bg-violet-700"
            >
                Save Course Videos
            </button>

        </div>

    </form>

</div>


<script>

function toggleChapter(chapterId) {

    const box =
        document.getElementById(
            `chapter-${chapterId}`
        );


    if (!box) {
        return;
    }


    const checkboxes =
        box.querySelectorAll(
            'input[type="checkbox"]'
        );


    const shouldCheck =
        [...checkboxes].some(
            checkbox =>
                !checkbox.checked
        );


    checkboxes.forEach(
        checkbox => {
            checkbox.checked =
                shouldCheck;
        }
    );

}

</script>