<div class="min-h-screen bg-slate-50">

    <div class="max-w-6xl mx-auto px-4 py-10">

        <a
            href="/courses-store"
            class="text-sm text-violet-600 hover:text-violet-800"
        >
            ← Back to Courses
        </a>


        <div class="mt-6 grid lg:grid-cols-3 gap-8">

            <!-- COURSE INFORMATION -->

            <div class="lg:col-span-2">

                <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden">

                    <% if (course.cover_image_url) { %>

                        <img
                            src="<%= course.cover_image_url %>"
                            alt="<%= course.course_name %>"
                            class="w-full h-72 object-cover"
                        >

                    <% } %>


                    <div class="p-7">

                        <p class="text-sm font-semibold text-violet-600">
                            <%= course.subject_name || "DNS Academy" %>
                        </p>


                        <h1 class="mt-2 text-3xl font-bold text-slate-900">
                            <%= course.course_name %>
                        </h1>


                        <% if (course.short_description) { %>

                            <p class="mt-4 text-slate-600">
                                <%= course.short_description %>
                            </p>

                        <% } %>


                        <% if (course.long_description) { %>

                            <div class="mt-7">

                                <h2 class="text-xl font-bold text-slate-900">
                                    About This Course
                                </h2>

                                <div class="mt-3 text-slate-600 whitespace-pre-line">
                                    <%= course.long_description %>
                                </div>

                            </div>

                        <% } %>

                    </div>

                </div>

            </div>


            <!-- PURCHASE CARD -->

            <div>

                <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm sticky top-6">

                    <p class="text-sm text-slate-500">
                        Course Fee
                    </p>


                    <div class="mt-1 text-4xl font-bold text-slate-900">
                        ₹<%= Number(course.price).toFixed(0) %>
                    </div>


                    <% if (isEnrolled) { %>

                        <!-- ALREADY PURCHASED -->

                        <div class="mt-5 rounded-xl bg-emerald-50 border border-emerald-200 p-4">

                            <p class="font-semibold text-emerald-700">
                                ✓ Course Purchased
                            </p>

                            <p class="mt-1 text-sm text-emerald-600">
                                Your course is unlocked.
                            </p>

                        </div>


                        <a
                            href="/my-courses/<%= course.id %>"
                            class="mt-5 block w-full text-center px-5 py-3 rounded-xl bg-emerald-600 text-white font-semibold hover:bg-emerald-700"
                        >
                            Start Learning
                        </a>


                    <% } else { %>

                        <!-- BUY NOW -->

                        <button
                            id="buyNowButton"
                            type="button"
                            class="mt-6 w-full px-5 py-3.5 rounded-xl bg-violet-600 text-white font-semibold hover:bg-violet-700 transition"
                        >
                            Buy Now
                        </button>


                        <p
                            id="paymentMessage"
                            class="mt-3 text-sm text-center text-slate-500"
                        ></p>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

</div>


<% if (!isEnrolled) { %>

    <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>

    <script>

        const buyNowButton =
            document.getElementById("buyNowButton");

        const paymentMessage =
            document.getElementById("paymentMessage");


        const courseId =
            "<%= course.id %>";


        // =========================================
        // BUY NOW
        // =========================================

        buyNowButton.addEventListener(
            "click",
            async () => {

                try {

                    buyNowButton.disabled = true;

                    buyNowButton.innerText =
                        "Creating Payment...";


                    paymentMessage.innerText =
                        "";


                    // =====================================
                    // CREATE PAYMENT ORDER
                    // =====================================

                    const response =
                        await fetch(
                            "/api/v1/course-payments/orders",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body:
                                    JSON.stringify({
                                        courseId:
                                            courseId
                                    })
                            }
                        );


                    const result =
                        await response.json();


                    if (!response.ok) {

                        throw new Error(
                            result.message ||
                            "Unable to create payment"
                        );
                    }


                    const paymentSessionId =
                        result.cashfree.paymentSessionId;


                    const environment =
                        result.cashfree.environment;


                    const orderId =
                        result.order.orderId;


                    // =====================================
                    // CASHFREE
                    // =====================================

                    const cashfree =
                        Cashfree({
                            mode:
                                environment === "production"
                                    ? "production"
                                    : "sandbox"
                        });


                    // =====================================
                    // OPEN CASHFREE
                    // =====================================

                    await cashfree.checkout({

                        paymentSessionId,

                        redirectTarget:
                            "_self"

                    });


                    /*
                     * Cashfree redirects back according
                     * to the return URL configured in the
                     * Cashfree order configuration.
                     *
                     * The verification route can then
                     * verify the order using orderId.
                     */


                } catch (error) {

                    console.error(
                        "Payment error:",
                        error
                    );


                    paymentMessage.innerText =
                        error.message ||
                        "Payment could not be started";


                    buyNowButton.disabled =
                        false;


                    buyNowButton.innerText =
                        "Buy Now";
                }

            }
        );

    </script>

<% } %>